-- ===================== TAB SWITCHING =====================
local tabTweens = {}
local function cancelPageTweens(page)
    if tabTweens[page] then
        for _, tw in ipairs(tabTweens[page]) do tw:Cancel() end
        tabTweens[page] = nil
    end
end
local function trackTween(page, tw)
    tabTweens[page] = tabTweens[page] or {}
    table.insert(tabTweens[page], tw)
end

local function fadeOutPage(page, cb)
    cancelPageTweens(page)
    local slide = TweenService:Create(page,
        TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.new(0, -18, 0, 0) })
    trackTween(page, slide)
    slide.Completed:Connect(function()
        page.Visible = false
        page.Position = UDim2.new(0, 18, 0, 0)
        if cb then cb() end
    end)
    slide:Play()
end

local function fadeInPage(page)
    cancelPageTweens(page)
    page.Position = UDim2.new(0, 18, 0, 0)
    page.Visible = true
    local slide = TweenService:Create(page,
        TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Position = UDim2.new(0, 0, 0, 0) })
    trackTween(page, slide)
    slide:Play()
end

local currentTab = nil
local function selectTab(name)
    if currentTab == name then return end
    for n, data in pairs(NavButtons) do
        local sel = (n == name)
        TweenService:Create(data.button, TweenInfo.new(0.22),
            { BackgroundColor3 = sel and Color3.fromRGB(20, 24, 30) or Panel }):Play()
        TweenService:Create(data.label, TweenInfo.new(0.22),
            { TextColor3 = sel and TextHi or TextMid }):Play()
        if sel and not data.highlight.Visible then
            data.highlight.Visible = true
            data.highlight.Size = UDim2.new(0, 0, 1, -16)
            TweenService:Create(data.highlight,
                TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Size = UDim2.new(0, 3, 1, -16) }):Play()
        elseif not sel and data.highlight.Visible then
            TweenService:Create(data.highlight, TweenInfo.new(0.15),
                { Size = UDim2.new(0, 0, 1, -16) }):Play()
            task.delay(0.15, function()
                data.highlight.Visible = false
                data.highlight.Size = UDim2.new(0, 3, 1, -16)
            end)
        end
    end
    local newPage = Pages[name]
    local oldPage = currentTab and Pages[currentTab] or nil
    currentTab = name
    if name ~= "Info Players" then
        closeExpanded()
    end
    if oldPage and oldPage ~= newPage then
        fadeOutPage(oldPage, function() fadeInPage(newPage) end)
    else
        fadeInPage(newPage)
    end
end

