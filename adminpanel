local function loadScripts(query)
    clearSbList()
    SbStatus.Visible = true
    SbStatus.Text = "Searching \"" .. (query or "") .. "\"..."
    SbStatus.TextColor3 = Accent
    animateSearchPress()

    local skeletons = showSkeletons(3)

    task.spawn(function()
        local url = "https://scriptblox.com/api/script/search?q="
            .. HttpService:UrlEncode(query or "") .. "&page=1&max=20"
        local result = httpGetJSON(url)

        for _, sk in ipairs(skeletons) do
            if sk.Parent then
                TweenService:Create(sk, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
            end
        end
        task.wait(0.22)
        for _, sk in ipairs(skeletons) do
            if sk.Parent then sk:Destroy() end
        end

        if not result or not result.result or not result.result.scripts then
            SbStatus.Text = "Couldn't reach ScriptBlox. Check your connection and try again."
            SbStatus.TextColor3 = Red
            showToast("Search Failed", "Could not reach ScriptBlox API", "error")
            return
        end

        local scripts = result.result.scripts
        if #scripts == 0 then
            SbStatus.Text = "No results for \"" .. (query or "") .. "\""
            SbStatus.TextColor3 = TextMid
            showToast("No Results", "Nothing found", "info")
            return
        end

        SbStatus.Visible = false
        for i, s in ipairs(scripts) do
            makeScriptCard(s, i)
        end

        showToast("Found " .. #scripts .. " Scripts",
            "Query: \"" .. (query == "" and "all" or query) .. "\"", "success")
    end)
end

