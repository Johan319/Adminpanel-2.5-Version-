                end)
            end)
        end)
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                plr.Chatted:Connect(function(msg) onRankMessage(msg, plr) end)
            end
            Players.PlayerAdded:Connect(function(plr)
                plr.Chatted:Connect(function(msg) onRankMessage(msg, plr) end)
            end)
        end)
    end)

    local function expireTemps()
        local now = os.clock()
        local changed = false
        for key, g in pairs(grants.temp) do
            if g.expires <= now + 0.0005 then
                grants.temp[key] = nil
                changed = true
                if logLine then
