            end)
            Shared.protections.threads[key] = th
        end
    elseif key == "antiscripters" then
        -- Premium: basic tool/script noise reduction (local)
        if on then
            local th = task.spawn(function()
                while protOn("antiscripters") do
                    pcall(function()
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LP and plr.Character then
                                for _, t in ipairs(plr.Character:GetChildren()) do
                                    if t:IsA("Tool") and t.Name:lower():find("kill") then
                                        -- ignore; cannot remove others' tools FE
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(1)
                end
            end)
            Shared.protections.threads[key] = th
        end
    elseif key == "antiflingcanoes" or key == "antiflingsmalljets" or key == "antiflinghelicopters" or key == "antiflingball" then
        if on then
            local th = task.spawn(function()
                while protOn(key) do
                    local char = LP.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local v = root.AssemblyLinearVelocity
                        if v.Magnitude > 120 then
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                    task.wait(0.1)
                end
            end)
            Shared.protections.threads[key] = th
        end
    elseif key == "antidoors" then
        if on then
            local function doorish(obj)
                local n = obj.Name:lower()
                return n:find("door") or n:find("gate")
            end
            local function apply()
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("BasePart") and doorish(d) then
                        pcall(function() d.CanCollide = false end)
                    end
                end
            end
            apply()
            local c = workspace.DescendantAdded:Connect(function(d)
                if d:IsA("BasePart") and doorish(d) then
                    pcall(function() d.CanCollide = false end)
                end
            end)
            Shared.protections.conns[key] = c
        end
    elseif key == "antibanana" then
        if on then
            local function sweep()
                for _, d in ipairs(workspace:GetDescendants()) do
                    local n = d.Name:lower()
                    if n:find("banana") or n:find("peel") then
                        pcall(function() d:Destroy() end)
                    end
                    pcall(function()
                        if d:HasTag("Minions2026_BananaPeel") then d:Destroy() end
                    end)
                end
            end
            sweep()
            local list = {}
            list[#list+1] = workspace.DescendantAdded:Connect(function(d)
                local n = d.Name:lower()
                if n:find("banana") or n:find("peel") then pcall(function() d:Destroy() end) end
            end)
            local th = task.spawn(function()
                while protOn("antibanana") do
                    sweep()
                    task.wait(5)
                end
            end)
            Shared.protections.conns[key] = list
            Shared.protections.threads[key] = th
        end
    elseif key == "bypassprop" then
        local lots = workspace:FindFirstChild("001_Lots")
        if lots then
            for _, h in pairs(lots:GetChildren()) do
                pcall(function()
                    local a = h:FindFirstChild("HousePickedByPlayer")
                    local b = a and a:FindFirstChild("HouseModel")
                    local r = b and b:FindFirstChild("Permissions:SetPropPlacementBlockedForOthers")
                    if r then r:InvokeServer(not on) end
                end)
            end
        end
    elseif key == "antiskybox" then
        if on then
            local IDS = {[115959405843119]=true,[115869670697835]=true,[100839513065432]=true}
            local list = {}
            local function bad(desc)
                if not desc then return false end
                local function hit(v)
                    if type(v) == "table" then
                        for _, id in ipairs(v) do if IDS[tonumber(id)] then return true end end
                        return false
                    end
                    return IDS[tonumber(v)] == true
                end
                if hit(desc.Head) or hit(desc.Face) or hit(desc.Shirt) or hit(desc.Pants) then return true end
                for _, b in ipairs({"Torso","RightArm","LeftArm","RightLeg","LeftLeg"}) do
                    if hit(desc[b]) then return true end
                end
                local f = false
                pcall(function()
                    for _, ac in ipairs(desc:GetAccessories(true)) do
                        if ac.AssetId and IDS[tonumber(ac.AssetId)] then f = true break end
                    end
                end)
                return f
            end
            local function strip(c)
                for _, n in ipairs({"Head","Torso","UpperTorso","LowerTorso","Left Leg","Right Leg","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"}) do
                    local p = c:FindFirstChild(n)
                    if p then pcall(function() p:Destroy() end) end
                end
            end
            local function watch(plr, char)
                if not protOn("antiskybox") or plr == LP or not char then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum then return end
                pcall(function() if bad(hum:GetAppliedDescription()) then strip(char) end end)
                list[#list+1] = hum.DescendantAdded:Connect(function()
                    if protOn("antiskybox") then pcall(function() if bad(hum:GetAppliedDescription()) then strip(char) end end) end
                end)
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP then
                    if plr.Character then watch(plr, plr.Character) end
                    list[#list+1] = plr.CharacterAdded:Connect(function(c) watch(plr, c) end)
                end
            end
            list[#list+1] = Players.PlayerAdded:Connect(function(plr)
                if plr ~= LP then list[#list+1] = plr.CharacterAdded:Connect(function(c) watch(plr, c) end) end
            end)
            Shared.protections.conns[key] = list
        end
    end
    return true
end

