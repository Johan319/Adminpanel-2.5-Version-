local guides = {}
local function clearGuides()
	for _, g in ipairs(guides) do g:Destroy() end
	guides = {}
end
local function addGuide(vertical, pos, len)
	local g = Instance.new("Frame")
	g.BackgroundColor3 = Color3.fromRGB(255, 80, 180)
	g.BackgroundTransparency = 0.2
	g.BorderSizePixel = 0
	g.ZIndex = 4
	g.Parent = toolGui
	if vertical then
		g.Position = UDim2.fromOffset(pos, 0)
		g.Size = UDim2.fromOffset(1, len)
	else
		g.Position = UDim2.fromOffset(0, pos)
		g.Size = UDim2.fromOffset(len, 1)
	end
	guides[#guides + 1] = g
end

local SNAP = 7
local function snapRect(inst, x, y, w, h)
	clearGuides()
	local par = inst.Parent
	local px, py, pw, ph = 0, 0, 0, 0
	if par and par:IsA("GuiObject") then
		px, py = par.AbsolutePosition.X, par.AbsolutePosition.Y
		pw, ph = par.AbsoluteSize.X, par.AbsoluteSize.Y
	else
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
		pw, ph = vs.X, vs.Y
	end
	local xs = { px, px + pw / 2, px + pw }
	local ys = { py, py + ph / 2, py + ph }
	if par then
		for _, sib in ipairs(par:GetChildren()) do
			if sib ~= inst and sib:IsA("GuiObject") then
				local a, s = sib.AbsolutePosition, sib.AbsoluteSize
				local nx, ny = #xs, #ys
				xs[nx + 1], xs[nx + 2], xs[nx + 3] = a.X, a.X + s.X / 2, a.X + s.X
				ys[ny + 1], ys[ny + 2], ys[ny + 3] = a.Y, a.Y + s.Y / 2, a.Y + s.Y
			end
		end
	end
	local function best(edges, refs)
		local bd, bo, bref = SNAP + 1, 0, nil
		for _, e in ipairs(edges) do
			for _, r in ipairs(refs) do
				local d = math.abs(e - r)
				if d < bd then bd, bo, bref = d, r - e, r end
			end
		end
		return bo, bref
	end
	local ox, gx = best({ x, x + w / 2, x + w }, xs)
	local oy, gy = best({ y, y + h / 2, y + h }, ys)
	if gx then addGuide(true, gx, 4000) end
	if gy then addGuide(false, gy, 4000) end
	return x + ox, y + oy
end

local function beginAction(mode, input)
	if not (selected and selected:IsA("GuiObject")) then return end
	-- pause float/pulse so drag is not fighting the animation
	if clearBuilderAnimation then pcall(clearBuilderAnimation, selected) end
	action = {
		mode = mode, start = input.Position, pos = selected.Position, size = selected.Size,
		abs = selected.AbsolutePosition, absSize = selected.AbsoluteSize,
		inst = selected,
	}
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End and action then
			local was = action.inst
			action = nil
			clearGuides()
			if was and applyBuilderAnimation then pcall(applyBuilderAnimation, was) end
			if refreshProperties then refreshProperties() end
		end
	end)
end

local function applyAction(input)
	if not (action and selected and selected.Parent) then return end
	local a = action
	local d = input.Position - a.start
	if a.mode == "move" then
		-- light snap only (no guide rebuild every pixel for performance)
		local nx = a.abs.X + d.X
		local ny = a.abs.Y + d.Y
		local s = SNAP
		local par = selected.Parent
		if par and par:IsA("GuiObject") then
			local px, py = par.AbsolutePosition.X, par.AbsolutePosition.Y
			local pw, ph = par.AbsoluteSize.X, par.AbsoluteSize.Y
			if math.abs(nx - px) < s then nx = px end
			if math.abs(ny - py) < s then ny = py end
			if math.abs(nx + a.absSize.X - (px + pw)) < s then nx = px + pw - a.absSize.X end
			if math.abs(ny + a.absSize.Y - (py + ph)) < s then ny = py + ph - a.absSize.Y end
		end
		selected.Position = UDim2.new(a.pos.X.Scale, a.pos.X.Offset + (nx - a.abs.X),
			a.pos.Y.Scale, a.pos.Y.Offset + (ny - a.abs.Y))
	else
		local m = a.mode
		local right, left = m:find("R") ~= nil, m:find("L") ~= nil
		local bottom, top = m:find("B") ~= nil, m:find("T") ~= nil
		local w, h = a.absSize.X, a.absSize.Y
		local nw, nh = w, h
		if right then nw = math.max(12, w + d.X) end
		if left then nw = math.max(12, w - d.X) end
		if bottom then nh = math.max(12, h + d.Y) end
		if top then nh = math.max(12, h - d.Y) end
		local an = selected.AnchorPoint
		local sx, sy = 0, 0
		if right then sx = (nw - w) * an.X end
		if left then sx = -(nw - w) * (1 - an.X) end
		if bottom then sy = (nh - h) * an.Y end
		if top then sy = -(nh - h) * (1 - an.Y) end
		selected.Size = UDim2.new(a.size.X.Scale, a.size.X.Offset + (nw - w), a.size.Y.Scale, a.size.Y.Offset + (nh - h))
		selected.Position = UDim2.new(a.pos.X.Scale, a.pos.X.Offset + sx, a.pos.Y.Scale, a.pos.Y.Offset + sy)
	end
end

