    local function toggleProtCmd(key, needPremium, needRank)
        return function(a)
            if needPremium and not Shared.premium then
                return false, "Locked Only Premium🔒"
            end
            if needRank and Shared.rank < needRank then
                return false, "Rank too low"
            end
            local on = not (Shared.protections and Shared.protections.states and Shared.protections.states[key])
            if a[1] then
                local s = string.lower(tostring(a[1]))
                if s == "on" or s == "1" or s == "true" then on = true
                elseif s == "off" or s == "0" or s == "false" then on = false end
            end
            if not Shared.setProtection then return false, "Protections not ready" end
            Shared.setProtection(key, on)
            if Shared._protRows then
                for _, r in ipairs(Shared._protRows) do
                    if r.item.key == key then r.setVisual(on) end
                end
            end
            return true, key .. (on and " ON" or " OFF")
        end
    end


