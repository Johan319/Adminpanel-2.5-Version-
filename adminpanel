    -- returns status (true / false / "unknown") and a message
    local function runCommand(raw)
        raw = tostring(raw or "")
        raw = raw:match("^%s*(.-)%s*$") or ""
        local p = state.prefix
        if raw:sub(1, #p) == p then
            raw = raw:sub(#p + 1)
        elseif raw:sub(1, 1) == ";" then
            raw = raw:sub(2)
        end
        local parts = {}
        for w in raw:gmatch("%S+") do parts[#parts + 1] = w end
        if #parts == 0 then return nil, nil end
        local name = table.remove(parts, 1):lower()
        local entry = LOOKUP[name]
        if not entry then
            return "unknown", "Unknown command: " .. ascii(name) .. '  (type "cmds" for the list)'
        end
        if Shared.rank < entry.rank then
            return false, (Shared.RANK_NAMES[entry.rank] or "Higher rank") .. " only command"
        end
        local ok, res, msg = pcall(entry.fn, parts)
        if not ok then return false, "Error: " .. ascii(res) end
        return res, msg
    end

