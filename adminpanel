    -- ---------- send / clear ----------
    local busy = false

    local function welcome()
        addBubble("ai", "Hi! I'm Johan AI. Ask me anything about Roblox, scripting or this game.", false)
    end

    local function send()
        if busy then
            -- while a reply is being typed out, Send becomes Skip
            if typingNow then skipTyping = true end
            return
        end
        local text = (Input.Text or ""):match("^%s*(.-)%s*$") or ""
        if text == "" then return end
        if #text > 1500 then text = text:sub(1, 1500) end

        -- deduct AI Premium tokens (0.05 – 0.10 cents-style random)
        local okSpend, cost = Shared.spendTokens()
        if not okSpend then
            addBubble("ai", string.format("Out of tokens (need ~%.2f, have %.2f). Refills in 2–4 hours, or (tokens disabled).", cost or 1, Shared.tokens), true)
            Shared.playTokenEmptyAnim(AiPage)
            return
        end

        Input.Text = ""
        busy = true
        SendBtn.Text = "..."

        addBubble("user", text, false)
        table.insert(history, { role = "user", text = text })
        while #history > 30 do table.remove(history, 1) end
        if history[1] and history[1].role ~= "user" then table.remove(history, 1) end

        local typing = addTyping()
        setTypingStatus(true)
        scrollBottom()

        task.spawn(function()
            local ok, reply, err = pcall(callGemini)
            if not ok then
                err = tostring(reply)
                reply = nil
            end
            if typing.Parent then typing:Destroy() end

            if reply then
                local clean = cleanReply(reply)
