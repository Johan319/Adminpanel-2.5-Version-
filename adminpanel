-- VANISH: pulls a character out of your workspace so it disappears on your screen only.
-- This does not remove the player from the server or affect anyone else's game.
Shared.vanish = { hidden = {}, conns = {} }

function Shared.vanishOn(plr)
    if not plr or plr == LP or Shared.vanish.hidden[plr.UserId] then return false end
    Shared.vanish.hidden[plr.UserId] = true

    local function hide(char)
        if char and char.Parent then char.Parent = nil end
    end
    hide(plr.Character)

    Shared.vanish.conns[plr.UserId] = plr.CharacterAdded:Connect(function(char)
        if Shared.vanish.hidden[plr.UserId] then hide(char) end
    end)
    return true
end

function Shared.vanishOff(plr)
    if not plr then return false end
    local uid = plr.UserId
    if not Shared.vanish.hidden[uid] then return false end
    Shared.vanish.hidden[uid] = nil
    local conn = Shared.vanish.conns[uid]
    if conn then
        conn:Disconnect()
        Shared.vanish.conns[uid] = nil
    end
    if plr.Character and plr.Character.Parent == nil then
        plr.Character.Parent = workspace
    end
    return true
end

function Shared.vanishClear()
    for uid in pairs(Shared.vanish.hidden) do
        local plr = Players:GetPlayerByUserId(uid)
        if plr then Shared.vanishOff(plr) end
    end
end

Shared.esp = { recs = {}, count = 0, conn = nil, folder = nil, listeners = {} }
Shared.STUD_TO_METER = 0.28      -- Roblox: 1 stud = 0.28 meters

function Shared.espNotify(plr, on)
    for f in pairs(Shared.esp.listeners) do pcall(f, plr, on) end
end

function Shared.espIsOn(plr)
    return plr ~= nil and Shared.esp.recs[plr.UserId] ~= nil
end

function Shared.espStartLoop()
    local e = Shared.esp
    if e.conn then return end
    local acc = 0
    e.conn = RunService.Heartbeat:Connect(function(dt)
        acc += dt
        if acc < 0.1 then return end
        acc = 0
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local gone = {}
        for _, rec in pairs(e.recs) do
            local plr = rec.plr
            if not plr.Parent then
                gone[#gone + 1] = plr
            else
                local char = plr.Character
                if char then
                    if rec.hl.Adornee ~= char then rec.hl.Adornee = char end
                    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if head and rec.bb.Adornee ~= head then rec.bb.Adornee = head end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root and myRoot then
                        local m = (root.Position - myRoot.Position).Magnitude * Shared.STUD_TO_METER
                        rec.dist.Text = string.format("%.1f m", m)
                    else
                        rec.dist.Text = "- m"
                    end
                else
                    rec.hl.Adornee = nil
                    rec.bb.Adornee = nil
                end
            end
        end
        for _, plr in ipairs(gone) do Shared.espOff(plr) end
    end)
end

function Shared.espStopLoop()
    local e = Shared.esp
    if e.conn then
        e.conn:Disconnect()
        e.conn = nil
    end
end

function Shared.espOn(plr)
    local e = Shared.esp
    if not plr or plr == LP or e.recs[plr.UserId] then return false end
    if not e.folder or not e.folder.Parent then
        e.folder = Instance.new("Folder")
        e.folder.Name = "AdminPanelESP"
        e.folder.Parent = CoreGui
    end

    local hl = Instance.new("Highlight")
    hl.FillColor = Accent
    hl.FillTransparency = 0.6
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = e.folder

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 170, 0, 48)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Parent = e.folder

    local function line(y, text, col, size)
        local l = Instance.new("TextLabel", bb)
        l.BackgroundTransparency = 1
        l.Position = UDim2.new(0, 0, 0, y)
        l.Size = UDim2.new(1, 0, 0, 16)
        l.Font = Enum.Font.GothamBold
        l.Text = text
        l.TextColor3 = col
        l.TextSize = size
        l.TextStrokeTransparency = 0.35
        l.TextStrokeColor3 = Color3.new(0, 0, 0)
        return l
    end
    line(0, Shared.ascii(plr.Name), TextHi, 13)              -- user
    line(15, Shared.ascii(plr.DisplayName), Accent, 12)      -- nickname
    local distLabel = line(30, "- m", Green, 11)             -- meters

    e.recs[plr.UserId] = { plr = plr, hl = hl, bb = bb, dist = distLabel }
    e.count += 1
    Shared.espStartLoop()
    Shared.espNotify(plr, true)
    return true
end

function Shared.espOff(plr)
    local e = Shared.esp
    local rec = plr and e.recs[plr.UserId]
    if not rec then return false end
    rec.hl:Destroy()
    rec.bb:Destroy()
    e.recs[plr.UserId] = nil
    e.count -= 1
    if e.count <= 0 then Shared.espStopLoop() end
    Shared.espNotify(plr, false)
    return true
end

function Shared.espToggle(plr)
    if Shared.espIsOn(plr) then
        Shared.espOff(plr)
        return false
    end
    return Shared.espOn(plr)
end

function Shared.espClear()
    local e = Shared.esp
    local list = {}
    for _, rec in pairs(e.recs) do list[#list + 1] = rec.plr end
    for _, plr in ipairs(list) do Shared.espOff(plr) end
    if e.folder then
        e.folder:Destroy()
        e.folder = nil
    end
end

