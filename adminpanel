local function showSkeletons(count)
    local skeletons = {}
    for i = 1, count do
        local sk = Instance.new("Frame", SbList)
        sk.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        sk.BorderSizePixel = 0
        sk.Size = UDim2.new(1, 0, 0, 82)
        sk.LayoutOrder = i + 1
        sk.ZIndex = 5
        corner(sk, 10)
        stroke(sk, StrokeCol, 1, 0.5)

        local blockAv = Instance.new("Frame", sk)
        blockAv.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        blockAv.BorderSizePixel = 0
        blockAv.AnchorPoint = Vector2.new(0, 0.5)
        blockAv.Position = UDim2.new(0, 14, 0.5, 0)
        blockAv.Size = UDim2.new(0, 58, 0, 58)
        blockAv.ZIndex = 6
        corner(blockAv, 10)

        local b1 = Instance.new("Frame", sk)
        b1.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        b1.BorderSizePixel = 0
        b1.Position = UDim2.new(0, 84, 0, 16)
        b1.Size = UDim2.new(0.5, 0, 0, 12)
        b1.ZIndex = 6
        corner(b1, 6)

        local b2 = Instance.new("Frame", sk)
        b2.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        b2.BorderSizePixel = 0
        b2.Position = UDim2.new(0, 84, 0, 36)
        b2.Size = UDim2.new(0.35, 0, 0, 10)
        b2.ZIndex = 6
        corner(b2, 5)

        table.insert(skeletons, sk)

        task.spawn(function()
            local t = 0
            while sk.Parent and sk.BackgroundTransparency < 1 do
                t += RunService.Heartbeat:Wait()
                local a = 0.5 + (math.sin(t * 3) + 1) * 0.25
                blockAv.BackgroundColor3 = Color3.fromRGB(30 * a + 20, 30 * a + 20, 30 * a + 20)
                b1.BackgroundColor3 = Color3.fromRGB(30 * a + 20, 30 * a + 20, 30 * a + 20)
                b2.BackgroundColor3 = Color3.fromRGB(25 * a + 18, 25 * a + 18, 25 * a + 18)
            end
        end)
    end
    return skeletons
end

