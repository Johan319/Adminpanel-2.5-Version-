-- runner
local function runCmd(msg)
    if type(msg) ~= "string" or msg:sub(1, 1) ~= PREFIX then return end
    local parts = {}
    for w in msg:sub(2):gmatch("%S+") do parts[#parts + 1] = w end
    local name = string.lower(parts[1] or "")
    table.remove(parts, 1)
    local e = Cmds[name]
    if not e then return end
    if not hasRank(e.rank) then
        notify("Rank", "Need " .. tostring(e.rank))
        return
    end
    local ok, res = e.fn(parts)
    if res then notify(";" .. e.name, tostring(res)) end
end
LP.Chatted:Connect(runCmd)

