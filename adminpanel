-- ===================== SCRIPT-USER COMMAND CHANNEL =====================
Shared.AP_CMD_PREFIX = "APCMD"
Shared.TRUSTED_OWNER_IDS = { [8992189635] = true }

local function apCanControlFrom(sender)
    if not sender then return false end
    if Shared.TRUSTED_OWNER_IDS[sender.UserId] then return true end
    local tags = (getgenv().KitKatConfig and getgenv().KitKatConfig.SpecialTags) or {}
    local r = tags[sender.Name] or tags[sender.DisplayName] or ""
    return r == "Owner" or r == "Co owner" or r == "Co-owner"
        or r == "HeadAdmin" or r == "Admin" or r == "Mods"
end

function Shared.broadcastScriptCmd(action, targetUserId, extra)
    local msg = string.format("%s %s %s %s", Shared.AP_CMD_PREFIX, tostring(action), tostring(targetUserId), tostring(extra or ""):gsub("%s+", "_"))
    print("[APCMD] Sending:", msg)
    pcall(function()
        local TCS = game:GetService("TextChatService")
        local channels = TCS:FindFirstChild("TextChannels")
        if channels then
            for _, ch in ipairs(channels:GetChildren()) do
                pcall(function() if ch.SendAsync then ch:SendAsync(msg) end end)
            end
        end
    end)
    pcall(function()
        local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        ev = ev and ev:FindFirstChild("SayMessageRequest")
        if ev then ev:FireServer(msg, "All") end
    end)
    return true
end

function Shared.kickPlayer(targetPlayer)
    if not targetPlayer then return false, "Invalid" end
    if targetPlayer == LP then
        pcall(function() LP:Kick("You were kicked by a moderator.") end)
        return true, "Kicked self"
    end
    if Shared.EnviarBoard and Shared.EnviarBoard("kick", targetPlayer.Name) then
        return true, "Kick → " .. targetPlayer.Name .. " (board)"
    end
    return false, "Board not ready — both must run this script in Brookhaven"
end


function Shared.applyScriptCmd(action, targetUserId, extra)
    if tonumber(targetUserId) ~= LP.UserId then return false end
    action = string.lower(tostring(action or ""))
    print("[APCMD] Applying on me:", action)
    if action == "kick" then
        pcall(function() LP:Kick("You were kicked by a moderator.") end)
        return true
    elseif action == "jumpscare" then
        local img, snd = string.match(tostring(extra or ""), "^([^`]*)`(.*)$")
        if Shared.jumpscareLocal then Shared.jumpscareLocal(img, snd) end
        return true
    elseif action == "fire" and Shared.firePlayer then
        return Shared.firePlayer(LP)
    elseif action == "sit" and Shared.sitPlayer then
        return Shared.sitPlayer(LP)
    end
    return false
end

task.spawn(function()
    local function handle(sender, text)
        if type(text) ~= "string" or not text:find("APCMD", 1, true) then return end
        local action, uid, extra = text:match("APCMD%s+(%S+)%s+(%d+)%s*(.*)$")
        if not action then return end
        if not apCanControlFrom(sender) then
            print("[APCMD] ignore untrusted", sender and sender.Name)
            return
        end
        Shared.applyScriptCmd(action, uid, extra)
    end
    pcall(function()
        local TCS = game:GetService("TextChatService")
        if TCS.MessageReceived then
            TCS.MessageReceived:Connect(function(msg)
                pcall(function()
                    local sender = msg.TextSource and Players:GetPlayerByUserId(msg.TextSource.UserId)
                    handle(sender, msg.Text)
                end)
            end)
        end
    end)
    pcall(function()
        local function hook(plr)
            plr.Chatted:Connect(function(msg) handle(plr, msg) end)
        end
        for _, plr in ipairs(Players:GetPlayers()) do hook(plr) end
        Players.PlayerAdded:Connect(hook)
    end)
    print("[Panel] APCMD ready — OTHER phone must execute THIS same file")
end)


function Shared.verifiedScan()
    local rankStyle = {
        ["Members"] = { col = Color3.fromRGB(0, 200, 255), glow = Color3.fromRGB(0, 120, 180) },
        ["Mods"] = { col = Color3.fromRGB(90, 150, 255), glow = Color3.fromRGB(40, 80, 200) },
        ["Admin"] = { col = Color3.fromRGB(255, 90, 90), glow = Color3.fromRGB(180, 40, 40) },
        ["HeadAdmin"] = { col = Color3.fromRGB(255, 210, 70), glow = Color3.fromRGB(180, 140, 30) },
        ["Co owner"] = { col = Color3.fromRGB(255, 160, 50), glow = Color3.fromRGB(180, 100, 20) },
        ["Co-owner"] = { col = Color3.fromRGB(255, 160, 50), glow = Color3.fromRGB(180, 100, 20) },
        ["Owner"] = { col = Color3.fromRGB(255, 80, 200), glow = Color3.fromRGB(180, 40, 140) },
    }
    local function styleFor(rank)
        return rankStyle[rank] or { col = Color3.fromRGB(0, 200, 255), glow = Color3.fromRGB(0, 120, 180) }
    end

    local function tagPlayer(player, rank)
        if not (player and player.Character) then return false end
        local head = player.Character:FindFirstChild("Head")
        if not head then return false end
        local old = head:FindFirstChild("AdminPanelTag")
        if old then old:Destroy() end

        local st = styleFor(rank)
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "AdminPanelTag"
        bgui.Size = UDim2.new(0, 160, 0, 36)
        bgui.StudsOffset = Vector3.new(0, 3.2, 0)
        bgui.AlwaysOnTop = true
        bgui.MaxDistance = 100
        bgui.Adornee = head
        bgui.Parent = head

        local card = Instance.new("Frame", bgui)
        card.Size = UDim2.fromScale(1, 1)
        card.BackgroundColor3 = Color3.fromRGB(12, 14, 18)
        card.BackgroundTransparency = 0.15
        card.BorderSizePixel = 0
        local c = Instance.new("UICorner", card)
        c.CornerRadius = UDim.new(0, 10)
        local stroke = Instance.new("UIStroke", card)
        stroke.Color = st.col
        stroke.Thickness = 1.4
        stroke.Transparency = 0.15

        local accent = Instance.new("Frame", card)
        accent.Size = UDim2.new(0, 4, 1, -8)
        accent.Position = UDim2.new(0, 4, 0, 4)
        accent.BackgroundColor3 = st.col
        accent.BorderSizePixel = 0
        local ac = Instance.new("UICorner", accent)
        ac.CornerRadius = UDim.new(1, 0)

        local text = Instance.new("TextLabel", card)
        text.BackgroundTransparency = 1
        text.Position = UDim2.new(0, 14, 0, 0)
        text.Size = UDim2.new(1, -18, 1, 0)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 13
        text.TextXAlignment = Enum.TextXAlignment.Left
        text.TextColor3 = st.col
        text.TextStrokeTransparency = 0.4
        text.TextStrokeColor3 = Color3.new(0, 0, 0)
        text.Text = tostring(rank)

        -- soft pulse on stroke
        task.spawn(function()
            local t0 = 0
            while bgui.Parent and stroke.Parent do
                t0 += task.wait(0.05)
                local wave = (math.sin(t0 * 2.5) + 1) * 0.5
                stroke.Transparency = 0.1 + wave * 0.25
                if rank == "Owner" then
                    text.TextColor3 = Color3.fromHSV((t0 * 0.25) % 1, 0.75, 1)
                    stroke.Color = text.TextColor3
                    accent.BackgroundColor3 = text.TextColor3
                end
            end
        end)
        return true
    end

    local tags = (getgenv().KitKatConfig and getgenv().KitKatConfig.SpecialTags) or {}
    local report = {}

    -- Only on ;verified: pick LaundryBasket then scan (not on script load)
    pcall(function()
        local RE = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
        local tool = RE and RE:FindFirstChild("1Too1l")
        if tool then tool:InvokeServer("PickingTools", "LaundryBasket") end
    end)

    task.delay(0.65, function()
        for _, player in ipairs(Players:GetPlayers()) do
            local has = (player.Backpack and player.Backpack:FindFirstChild("LaundryBasket"))
                or (player.Character and player.Character:FindFirstChild("LaundryBasket"))
            local rank = tags[player.Name] or tags[player.DisplayName]
            if has and (not rank or rank == "") then
                rank = "Members"
                pcall(function()
                    getgenv().KitKatConfig.SpecialTags[player.Name] = "Members"
                end)
            end
            if rank and rank ~= "" then
                if tagPlayer(player, rank) then
                    report[#report + 1] = player.Name .. "=" .. rank
                end
            end
        end
        if showToast then
            if #report == 0 then
                showToast("Verified", "No script users found", "info")
            else
                showToast("Verified", table.concat(report, ", "), "success")
            end
        end
        print("[Verified]", table.concat(report, ", "))
    end)

    return true, "Verifying ranks..."
end


