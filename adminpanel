    local function handleKeyAction(actionName, inputState, inputObject)
        if not fc.active then return Enum.ContextActionResult.Pass end
        if inputObject and inputObject.KeyCode then
            local keyName = interceptedKeyCodes[inputObject.KeyCode]
            if keyName then
                fc.keysDown[keyName] = (inputState == Enum.UserInputState.Begin)
            end
        end
        return Enum.ContextActionResult.Sink
    end

    local function startFreecam()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root then return false end
        camera = workspace.CurrentCamera
        pcall(function() hum:UnequipTools() end)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
        fc.fallingAfterTeleport = false
        fc.originalAnchored = root.Anchored
        fc.frozenCFrame = root.CFrame
        root.Anchored = true
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if fc.controls then pcall(function() fc.controls:Disable() end) end
        local touchGui = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild("TouchGui")
        if touchGui then touchGui.Enabled = false end
        ContextActionService:BindActionAtPriority(
            "AP_VisualFreecamSink", handleKeyAction, false, 2000000,
            Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
            Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.Space,
            Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift,
            Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
            Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight,
            Enum.PlayerActions.CharacterJump
        )
        if fc.rememberPosition and fc.savedPos then
            fc.camPos, fc.camPitch, fc.camYaw = fc.savedPos, fc.savedPitch, fc.savedYaw
        else
            local currentCF = camera.CFrame
            fc.camPos = currentCF.Position
            local x, y = currentCF:ToOrientation()
            fc.camPitch, fc.camYaw = math.deg(x), math.deg(y)
        end
        camera.CameraType = Enum.CameraType.Scriptable
        if fc.renderConnection then fc.renderConnection:Disconnect() end
        fc.renderConnection = RunService.RenderStepped:Connect(function(dt)
            camera = workspace.CurrentCamera
            char = LP.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            if char and root then
                if fc.fallingAfterTeleport then
                    local elapsed = tick() - fc.teleportFallStartTime
                    local vel = root.AssemblyLinearVelocity
                    local groundParams = RaycastParams.new()
                    groundParams.FilterType = Enum.RaycastFilterType.Exclude
                    groundParams.FilterDescendantsInstances = { char }
                    local castDist = (root.Size.Y / 2) + 0.35
                    local groundHit = workspace:Raycast(root.Position, Vector3.new(0, -castDist, 0), groundParams)
                    if elapsed > 0.15 and ((groundHit and math.abs(vel.Y) < 1.5) or elapsed > 8) then
                        fc.fallingAfterTeleport = false
                        root.Anchored = true
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        fc.frozenCFrame = root.CFrame
                    end
                else
                    root.CFrame = fc.frozenCFrame
                    root.Anchored = true
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
            local rotCFrame = CFrame.Angles(0, math.rad(fc.camYaw), 0) * CFrame.Angles(math.rad(fc.camPitch), 0, 0)
            local moveVector = Vector3.zero
            if fc.joystickVector.Magnitude > 0.05 then
                moveVector = moveVector + rotCFrame.RightVector * fc.joystickVector.X + rotCFrame.LookVector * fc.joystickVector.Y
            end
            local kbF, kbR, kbU = 0, 0, 0
            if fc.keysDown.W then kbF = kbF + 1 end
            if fc.keysDown.S then kbF = kbF - 1 end
            if fc.keysDown.D then kbR = kbR + 1 end
            if fc.keysDown.A then kbR = kbR - 1 end
            if fc.keysDown.E then kbU = kbU + 1 end
            if fc.keysDown.Q then kbU = kbU - 1 end
            if kbF ~= 0 or kbR ~= 0 or kbU ~= 0 then
                moveVector = moveVector + rotCFrame.LookVector * kbF + rotCFrame.RightVector * kbR + Vector3.new(0, 1, 0) * kbU
            end
            if moveVector.Magnitude > 0 then
                local mult = fc.keysDown.LeftShift and 2 or 1
                fc.camPos = fc.camPos + moveVector.Unit * (fc.flySpeed * mult * dt)
            end
            camera.CFrame = CFrame.new(fc.camPos) * rotCFrame
        end)
        return true
    end

