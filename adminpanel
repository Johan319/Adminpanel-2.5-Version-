    local games = {}

    local function clean(s)
        return (tostring(s or ""):gsub("[^ -~]", "?"))
    end

    local function saveGames()
        if not canSave then return end
        pcall(function()
            writefile(GAMES_FILE, HttpService:JSONEncode({ games = games }))
        end)
    end

    if canSave then
        pcall(function()
            if isfile(GAMES_FILE) then
                local data = HttpService:JSONDecode(readfile(GAMES_FILE))
                if type(data) == "table" and type(data.games) == "table" then
                    for _, g in ipairs(data.games) do
                        if type(g) == "table" and tonumber(g.id) then
                            games[#games + 1] = {
                                id = tonumber(g.id),
                                name = clean(g.name),
                                last = tonumber(g.last) or 0,
                                plays = tonumber(g.plays) or 1,
                            }
                        end
                    end
                end
            end
        end)
