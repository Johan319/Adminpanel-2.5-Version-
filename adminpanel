-- ===================== OVERVIEW: GAMES YOU PLAYED =====================
do
    local GAMES_FILE = "AdminPanel_games.json"
    local MAX_GAMES = 40
    local MarketplaceService = game:GetService("MarketplaceService")
    local canSave = (writefile ~= nil and readfile ~= nil and isfile ~= nil)
    local games = {}

    local function clean(s)
        return (tostring(s or ""):gsub("[^ -~]", "?"))
    end

    local function saveGames()
        if not canSave then return end
        pcall(function()
            writefile(GAMES_FILE, HttpService:JSONEncode({ games = games }))
        end)
    end

    if canSave then
        pcall(function()
            if isfile(GAMES_FILE) then
                local data = HttpService:JSONDecode(readfile(GAMES_FILE))
                if type(data) == "table" and type(data.games) == "table" then
                    for _, g in ipairs(data.games) do
                        if type(g) == "table" and tonumber(g.id) then
                            games[#games + 1] = {
                                id = tonumber(g.id),
                                name = clean(g.name),
                                last = tonumber(g.last) or 0,
                                plays = tonumber(g.plays) or 1,
                            }
                        end
                    end
                end
            end
        end)
    end

    -- record the game you are in right now
    local placeId = game.PlaceId
    local current
    for _, g in ipairs(games) do
        if g.id == placeId then
            current = g
            break
        end
    end
    if current then
        current.plays += 1
        current.last = os.time()
    else
        current = { id = placeId, name = clean(game.Name), last = os.time(), plays = 1 }
        table.insert(games, 1, current)
    end
    table.sort(games, function(a, b) return a.last > b.last end)
    while #games > MAX_GAMES do table.remove(games) end
    saveGames()

    -- card in the Overview tab
    local Card = Instance.new("Frame", Overview)
    Card.Name = "GamesPlayed"
    Card.LayoutOrder = 6
