local scriptCache = {}

local function getGameThumb(universeId, callback)
    if not universeId or universeId == 0 then callback(nil) return end
    if thumbCache[universeId] ~= nil then callback(thumbCache[universeId] or nil) return end
    task.spawn(function()
        local url = "https://thumbnails.roproxy.com/v1/games/icons?universeIds="
            .. tostring(universeId) .. "&size=150x150&format=Png&isCircular=false"
        local res = httpGetJSON(url)
        local imageUrl = nil
        if res and res.data and res.data[1] and res.data[1].imageUrl then
            imageUrl = res.data[1].imageUrl
        end
        thumbCache[universeId] = imageUrl or false
        callback(imageUrl)
    end)
end

local function fetchFullScript(scriptData)
    if type(scriptData) ~= "table" then return nil end
    -- the single-script endpoint is keyed by slug; fall back to the id
    local keys = {}
    if scriptData.slug then table.insert(keys, scriptData.slug) end
    if scriptData._id then table.insert(keys, scriptData._id) end
    if scriptData.id then table.insert(keys, scriptData.id) end
    for _, key in ipairs(keys) do
        if scriptCache[key] then return scriptCache[key] end
        local res = httpGetJSON("https://scriptblox.com/api/script/" .. tostring(key))
        local body = res and res.script and res.script.script
        if type(body) == "string" and body ~= "" then
            scriptCache[key] = body
            return body
        end
    end
    return nil
end

local function showExecuteToast(scriptData)
    local toast = showToast("Fetching script...", scriptData.title or "Untitled", "loading", 0)

    task.spawn(function()
        task.wait(0.25)
        local code = scriptData.script
        if not code or code == "" then
            code = fetchFullScript(scriptData)
        end

        if not code or code == "" then
            toast.spinner.Visible = false
            toast.titleLbl.Text = "Fetch Failed"
            toast.msgLbl.Text = "Could not retrieve script source"
            toast.stroke.Color = Red
            task.delay(2, toast.dismiss)
            return
        end

        toast.titleLbl.Text = "Executing..."
        toast.msgLbl.Text = scriptData.title or "Untitled Script"

        task.wait(0.15)
        local ok, msg = safeExecute(code)

        toast.spinner.Visible = false
        if ok then
            toast.titleLbl.Text = "Executed Successfully"
            toast.msgLbl.Text = "Script is now running"
            toast.stroke.Color = Green
            toast.stroke.Transparency = 0.2
        else
            toast.titleLbl.Text = "Execution Failed"
            toast.msgLbl.Text = tostring(msg):sub(1, 80)
            toast.stroke.Color = Red
        end

        task.delay(2, toast.dismiss)
    end)
end

local function fmtNum(n)
    n = tonumber(n) or 0
    if n >= 1000000 then
        local s = string.format("%.1f", n / 1000000)
        s = s:gsub("%.0$", "")
        return s .. "M"
    elseif n >= 1000 then
        local s = string.format("%.1f", n / 1000)
        s = s:gsub("%.0$", "")
        return s .. "K"
    end
    return tostring(math.floor(n))
end

