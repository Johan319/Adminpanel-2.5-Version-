local function resolve(name)
    if not name or name == "" then return nil end
    name = tostring(name):lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or p.DisplayName:lower() == name then return p end
        if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then return p end
    end
    local id = tonumber(name)
    if id then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId == id then return p end
        end
    end
    return nil
end

local function names()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then t[#t + 1] = p.Name end
    end
    table.sort(t)
    return t
end

-- props
local function getMyProps()
    local props, wc = {}, workspace:FindFirstChild("WorkspaceCom")
    if not wc then return props end
    local my = LP.Name
    for _, folder in ipairs(wc:GetChildren()) do
        for _, prop in ipairs(folder:GetChildren()) do
            if prop:FindFirstChild("SetCurrentCFrame") then
                local n = prop.Name
                if n:find("Prop" .. my, 1, true) or n:find(my, 1, true) then
                    props[#props + 1] = prop
                end
            end
        end
    end
    return props
end

local function clearProps()
    pcall(function()
        local r = RE()
        local c = r and r:FindFirstChild("1Clea1rTool1s")
        if c then c:FireServer("ClearAllTools") c:FireServer("ClearAllProps") end
    end)
end

local function placeProps(n)
    n = n or 3
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end
    local r = RE()
    if not r then return false end
    local toolPick, clearTools = r:FindFirstChild("1Too1l"), r:FindFirstChild("1Clea1rTool1s")
    if not toolPick or not clearTools then return false end
    pcall(function() hum.Sit = false end)
    clearProps()
    task.wait(0.12)
    pcall(function() toolPick:InvokeServer("PickingTools", "PropMaker") end)
    task.wait(0.35)
    local tool = LP.Backpack:FindFirstChild("PropMaker")
        or (LP.Character and LP.Character:FindFirstChild("PropMaker"))
        or LP.Backpack:WaitForChild("PropMaker", 5)
    if not tool then return false end
    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.25)
    pcall(function() clearTools:FireServer("RequestingPropName", "FurnitureBleachers", "Furniture") end)
    task.wait(0.4)
    local toolRemote = tool:FindFirstChild("Tool_PropMake")
    if not toolRemote and LP.Character then
        local t2 = LP.Character:FindFirstChild("PropMaker")
        toolRemote = t2 and t2:FindFirstChild("Tool_PropMake")
    end
    local base
    pcall(function() base = workspace.__DEV.SwappableWorld.SideArea.ToBeSwapped.Baseplate end)
    base = base or workspace
    if toolRemote then
        local pos = hrp.Position + Vector3.new(0, -8, 0)
        for _ = 1, n do
            pcall(function() toolRemote:FireServer(base, pos) end)
            task.wait(0.18)
        end
    end
    for _ = 1, 15 do
        if #getMyProps() > 0 then return true end
        task.wait(0.1)
    end
    return #getMyProps() > 0
end

local function teleportProps(cf)
    for _, prop in ipairs(getMyProps()) do
        task.spawn(function()
            pcall(function() prop.SetCurrentCFrame:InvokeServer(cf) end)
        end)
    end
end

local function propMove(target, mode)
    if not target or target == LP then return false, "Invalid" end
    task.spawn(function()
        if not placeProps(3) then notify("Hub", "Props failed") return end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local myHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        local dest
        if mode == "kill" then dest = CFrame.new(216, -1338, -477)
        elseif mode == "fling" then dest = CFrame.new(1082537, 81322368, -4719626)
        else dest = hrp and (hrp.CFrame * CFrame.new(0, 0, -6)) or CFrame.new() end
        local start, seated, lift = tick(), false, -10
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if myHum and myHum.Sit then pcall(function() myHum.Sit = false end) end
            local c = target.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if not r or not h or (tick() - start > 12) then
                if conn then conn:Disconnect() end
                task.delay(1, clearProps)
                return
            end
            if h.Sit then
                if not seated then
                    seated = true
                    teleportProps(dest)
                    task.wait(0.35)
                    if conn then conn:Disconnect() end
                    task.delay(0.8, clearProps) -- auto clear after bring/kill/fling
                else
                    teleportProps(dest)
                end
            else
                lift = lift + 0.5
                if lift > 2 then lift = -10 end
                teleportProps(r.CFrame * CFrame.new(0, lift, 0))
            end
        end)
    end)
    return true, mode .. " " .. target.Name
end

-- freecam / vanish
local fc = { on = false, conn = nil, speed = 80 }
local function stopFreecam()
    fc.on = false
    if fc.conn then pcall(function() fc.conn:Disconnect() end) fc.conn = nil end
    pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
end
local function startFreecam()
    stopFreecam()
    fc.on = true
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Scriptable
    local pos = cam.CFrame.Position
    fc.conn = RunService.RenderStepped:Connect(function(dt)
        if not fc.on then return end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move -= Vector3.new(0, 1, 0) end
        pos += move * fc.speed * dt
        cam.CFrame = CFrame.new(pos, pos + cam.CFrame.LookVector)
    end)
end

local vanishCF
local function doVanish(on)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = LP.Character:FindFirstChildOfClass("Humanoid")
    if on then
        vanishCF = hrp.CFrame
        hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 500, 0))
        hrp.Anchored = true
        if hum then hum.PlatformStand = true end
    else
        hrp.Anchored = false
        if hum then hum.PlatformStand = false end
        if vanishCF then hrp.CFrame = vanishCF end
    end
end

local function setNoclip(on)
    NoclipOn = on
    if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
    if on then
        NoclipConn = RunService.Stepped:Connect(function()
            local char = LP.Character
            if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    end
end

local function setProt(key, on)
    Prot[key] = on and true or false
    if key == "antisit" or key == "antisitv2" then
        if on then
            task.spawn(function()
                while Prot[key] do
                    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                    if h and h.Sit then pcall(function() h.Sit = false end) end
                    task.wait(0.12)
                end
            end)
        end
    elseif key == "antivoid" then
        pcall(function() workspace.FallenPartsDestroyHeight = -math.huge end)
        if on then
            task.spawn(function()
                while Prot.antivoid do
                    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and hrp.Position.Y < -400 then
                        pcall(function() hrp.CFrame = CFrame.new(0, 80, 0) end)
                    end
                    task.wait(0.4)
                end
            end)
        end
    elseif key == "anticollision" then
        if on then
            task.spawn(function()
                while Prot.anticollision do
                    local char = LP.Character
                    if char then
                        for _, p in ipairs(char:GetDescendants()) do
                            if p:IsA("BasePart") then pcall(function() p.CanCollide = false end) end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    elseif key == "antibanana" then
        if on then
            task.spawn(function()
                while Prot.antibanana do
                    for _, d in ipairs(workspace:GetDescendants()) do
                        local n = d.Name:lower()
                        if n:find("banana") or n:find("peel") then pcall(function() d:Destroy() end) end
                    end
                    task.wait(3)
                end
            end)
        end
    end
end

