    local function expireTemps()
        local now = os.clock()
        local changed = false
        for key, g in pairs(grants.temp) do
            if g.expires <= now + 0.0005 then
                grants.temp[key] = nil
                changed = true
                if logLine then
                    logLine("Temp rank ended for " .. ascii(g.name) .. " (" .. tostring(g.label or "rank") .. ")", "info")
                end
                if key == tostring(LP.UserId) then
                    showToast("Temp Rank", "Your temp rank ended", "info")
                end
            end
        end
        if changed then syncMyGrants() end
    end

