        f.AnchorPoint = centered and Vector2.new(0.5, 0.5) or Vector2.new(0, 0)
        f.Position = UDim2.new(0, px, 0, py)
        f.Size = UDim2.new(0, sx, 0, sy)
        f.Rotation = rot
        f.ZIndex = z
        f.Active = false
        corner(f, rad)
        return f
    end
    local dark = Color3.fromRGB(12, 24, 30)
    local outerTop = shape(0, 0, 20, 15, 0, Accent, 4, 53, false)
    local outerTip = shape(10, 14, 14, 14, 45, Accent, 2, 53, true)
    shape(2, 2, 16, 11, 0, dark, 3, 54, false)
    shape(10, 13, 11, 11, 45, dark, 2, 54, true)
    shape(7.9, 11, 2.4, 9, -25, Accent, 1, 55, true)
    shape(12.1, 11, 2.4, 9, 25, Accent, 1, 55, true)

    open.MouseEnter:Connect(function()
        TweenService:Create(open, TweenInfo.new(0.15), { Size = UDim2.new(0, 48, 0, 48) }):Play()
        TweenService:Create(ring, TweenInfo.new(0.15), { Transparency = 0 }):Play()
    end)
    open.MouseLeave:Connect(function()
        TweenService:Create(open, TweenInfo.new(0.15), { Size = UDim2.new(0, 44, 0, 44) }):Play()
        TweenService:Create(ring, TweenInfo.new(0.15), { Transparency = 0.15 }):Play()
    end)
    open.MouseButton1Click:Connect(function()
        open.Visible = false
        openPanel()
    end)
    return open
end

