local function refreshLive(plr)
    local dist, hp = "N/A", "N/A"
    pcall(function()
        local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local tChar = plr.Character
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if myHRP and tHRP then
            dist = math.floor((myHRP.Position - tHRP.Position).Magnitude) .. " studs"
        end
        local hum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if hum then
            hp = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
        end
    end)
    nat.dist.Text = dist
    nat.health.Text = hp
end

local function applyOnline(data)
    if data then
        onl.friends.Text = data.friends
        onl.followers.Text = data.followers
        onl.following.Text = data.following
        BioV.Text = data.desc
