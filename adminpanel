		codeBox.Text = pages[pageIndex] or ""
		pageLabel.Text = string.format("Part %d/%d", pageIndex, #pages)
	end

	gen.MouseButton1Click:Connect(function()
		local nodes = serializeChildren(projectGui)
		if #nodes == 0 then
			codeBox.Text = "Your GUI is empty. Add something first."
			pages, pageIndex = { "" }, 1
			pageLabel.Text = ""
			return
		end
		local code = generateLua(nodes)
		fullCode = code
		pages = {}
		local current, len = {}, 0
		for line in (code .. "\n"):gmatch("([^\n]*)\n") do
			if len + #line + 1 > PAGE_SIZE and #current > 0 then
				pages[#pages + 1] = table.concat(current, "\n")
				current, len = {}, 0
			end
			current[#current + 1] = line
			len += #line + 1
		end
		if #current > 0 then pages[#pages + 1] = table.concat(current, "\n") end
		pageIndex = 1
		showPage()
	end)
	copyAll.MouseButton1Click:Connect(function()
