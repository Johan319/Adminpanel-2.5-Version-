                    Url = url,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = payload,
                })
            end)
            if ok and type(res) == "table" and type(res.Body) == "string" then
                return decode(res.Body), tonumber(res.StatusCode) or 0
            end
            return nil, 0
        end

        local ok2, body = pcall(function()
            return game:HttpPost(url, payload, "application/json")
        end)
        if ok2 and type(body) == "string" then return decode(body), 200 end
        return nil, 0
    end

    local function postWithTimeout(url, payload, secs)
        local done, data, status = false, nil, 0
        task.spawn(function()
            data, status = httpPostJSON(url, payload)
            done = true
        end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < secs do task.wait(0.1) end
        if not done then return nil, -1 end
        return data, status
    end

    local function routeUrl(host, model)
        if host == "studio" then
            return "https://generativelanguage.googleapis.com/v1beta/models/"
                .. model .. ":generateContent?key=" .. GEMINI_API_KEY
        end
        return "https://aiplatform.googleapis.com/v1/publishers/google/models/"
            .. model .. ":generateContent?key=" .. GEMINI_API_KEY
    end

    local function extractText(data)
        local c = data and data.candidates and data.candidates[1]
        local parts = c and c.content and c.content.parts
        if type(parts) ~= "table" then return nil end
        local out = {}
        for _, part in ipairs(parts) do
            if type(part.text) == "string" then table.insert(out, part.text) end
        end
        if #out == 0 then return nil end
        return table.concat(out)
    end

    local function errorOf(data)
        local e = data and (data.error or (data[1] and data[1].error))
        if type(e) == "table" and e.message then return tostring(e.message) end
        return nil
    end

    -- Google issues two key styles (AI Studio and Vertex express, both can start with
    -- "AQ."), so try both hosts and remember whichever one works.
    local workingRoute = nil

    local function callGemini()
        if GEMINI_API_KEY == "" then return nil, "No API key set" end

        local contents = {}
        for _, h in ipairs(history) do
            table.insert(contents, { role = h.role, parts = { { text = h.text } } })
        end
        local payload = HttpService:JSONEncode({
            systemInstruction = { parts = { { text = SYSTEM_PROMPT } } },
            contents = contents,
            generationConfig = { temperature = 0.7, maxOutputTokens = 2048 },
        })

        local routes = {}
        if workingRoute then table.insert(routes, workingRoute) end
        for _, m in ipairs(MODELS) do
            for _, h in ipairs({ "studio", "vertex" }) do
                local dup = workingRoute and workingRoute.host == h and workingRoute.model == m
                if not dup then table.insert(routes, { host = h, model = m }) end
            end
        end

        local lastErr = "Couldn't reach Gemini. Check your connection."
        for _, r in ipairs(routes) do
            local data, status = postWithTimeout(routeUrl(r.host, r.model), payload, 25)
            status = tonumber(status) or 0

            if status == -1 then
                return nil, "Request timed out. Try again."
            end

            if data and status >= 200 and status < 300 then
                local text = extractText(data)
                if text then
                    workingRoute = r
                    return text
                end
                local block = data.promptFeedback and data.promptFeedback.blockReason
                return nil, block and ("Blocked: " .. tostring(block)) or "Empty reply, try rephrasing."
            end

            if status == 429 then
                return nil, "Rate limit reached. Wait a moment and try again."
            end

            local msg = errorOf(data)
            if msg then
                lastErr = cleanReply(msg)
                if #lastErr > 160 then lastErr = lastErr:sub(1, 157) .. "..." end
            end
        end
        return nil, lastErr
    end

    -- one-shot Gemini call used by the GUI Builder (returns text, or nil and an error)
    function Shared.gemini(systemText, userText, maxTokens)
        if GEMINI_API_KEY == "" then return nil, "No API key set" end
        local payload = HttpService:JSONEncode({
            systemInstruction = { parts = { { text = systemText } } },
            contents = { { role = "user", parts = { { text = userText } } } },
            generationConfig = { temperature = 0.4, maxOutputTokens = maxTokens or 4096 },
        })

        local routes = {}
        if workingRoute then table.insert(routes, workingRoute) end
        for _, m in ipairs(MODELS) do
            for _, h in ipairs({ "studio", "vertex" }) do
                local dup = workingRoute and workingRoute.host == h and workingRoute.model == m
                if not dup then table.insert(routes, { host = h, model = m }) end
            end
        end

        local lastErr = "Couldn't reach Gemini. Check your connection."
        for _, r in ipairs(routes) do
            local data, status = postWithTimeout(routeUrl(r.host, r.model), payload, 60)
            status = tonumber(status) or 0
            if status == -1 then
                return nil, "Request timed out. Try again."
            end
            if data and status >= 200 and status < 300 then
                local text = extractText(data)
                if text then
                    workingRoute = r
                    return text
                end
                return nil, "Empty reply, try rephrasing."
            end
            if status == 429 then
                return nil, "Rate limit reached. Wait a moment and try again."
            end
            local msg = errorOf(data)
            if msg then
                lastErr = cleanReply(msg)
                if #lastErr > 160 then lastErr = lastErr:sub(1, 157) .. "..." end
            end
        end
        return nil, lastErr
    end

    -- ---------- typing / writing animations + copy button ----------
    local typingNow, skipTyping = false, false
    local statusToken = 0

    local function nearBottom()
        local ok, res = pcall(function()
            return (Chat.AbsoluteCanvasSize.Y - Chat.AbsoluteWindowSize.Y
                - Chat.CanvasPosition.Y) < 70
        end)
        return (not ok) or res
    end

    local function snapBottom()
        pcall(function()
            Chat.CanvasPosition = Vector2.new(0,
                math.max(0, Chat.AbsoluteCanvasSize.Y - Chat.AbsoluteWindowSize.Y))
        end)
    end

    -- header shows "Johan AI is typing..." while a reply is coming
    local function setTypingStatus(active)
        statusToken += 1
        local token = statusToken
        if not active then
            AiS.Text = "Ask anything - Powered by Johan AI"
            AiS.TextColor3 = TextMid
            return
        end
        AiS.TextColor3 = Accent
        task.spawn(function()
            local n = 0
            while statusToken == token and AiPage.Parent do
                n = n % 3 + 1
                AiS.Text = "Johan AI is typing" .. string.rep(".", n)
                task.wait(0.35)
            end
        end)
    end

    -- three bouncing dots while waiting for the reply
    local function addTyping()
        msgOrder += 1
        local wrap = Instance.new("Frame", Chat)
        wrap.BackgroundTransparency = 1
        wrap.Size = UDim2.new(1, 0, 0, 34)
        wrap.LayoutOrder = msgOrder
        wrap.ZIndex = 5

        local bub = Instance.new("Frame", wrap)
        bub.BackgroundColor3 = Panel
        bub.BorderSizePixel = 0
        bub.Size = UDim2.new(0, 62, 0, 32)
        bub.ZIndex = 6
        corner(bub, 10)
        stroke(bub, StrokeCol, 1, 0.3)
        popIn(bub, 0)

        local dots = {}
        for i = 1, 3 do
            local d = Instance.new("Frame", bub)
            d.BackgroundColor3 = Accent
            d.BorderSizePixel = 0
            d.AnchorPoint = Vector2.new(0.5, 0.5)
            d.Size = UDim2.new(0, 7, 0, 7)
            d.Position = UDim2.new(0, 17 + (i - 1) * 14, 0.5, 0)
            d.ZIndex = 7
            corner(d, 4)
            dots[i] = d
        end

        task.spawn(function()
            local t = 0
            while wrap.Parent do
                t += RunService.Heartbeat:Wait()
                for i, d in ipairs(dots) do
                    local w = math.sin(t * 7 - i * 0.9)
                    local k = (w + 1) / 2
                    d.Position = UDim2.new(0, 17 + (i - 1) * 14, 0.5, -w * 4)
                    d.BackgroundTransparency = 0.55 - 0.55 * k
                    local s = 6 + 2 * k
                    d.Size = UDim2.new(0, s, 0, s)
                end
            end
        end)
        return wrap
    end

    -- reveals the reply letter by letter (tap Skip to show it all at once)
    local function typewrite(label)
        local full = label.Text
        local total = utf8.len(full) or #full
        typingNow, skipTyping = true, false
        local follow = nearBottom()
        label.MaxVisibleGraphemes = 0
        local dur = math.clamp(total / 160, 0.6, 5)
        local t0 = os.clock()
        while label.Parent and not skipTyping do
            local a = (os.clock() - t0) / dur
            if a >= 1 then break end
            label.MaxVisibleGraphemes = math.floor(total * a)
            if follow then snapBottom() end
            RunService.Heartbeat:Wait()
        end
        label.MaxVisibleGraphemes = -1
        typingNow, skipTyping = false, false
        if follow then scrollBottom() end
    end

    local function addCopyButton(wrap, getText)
        local cb = Instance.new("TextButton", wrap)
        cb.LayoutOrder = 2
        cb.BackgroundColor3 = Panel
        cb.BorderSizePixel = 0
        cb.Size = UDim2.new(0, 60, 0, 22)
        cb.Font = Enum.Font.GothamBold
        cb.Text = "Copy"
        cb.TextColor3 = TextMid
        cb.TextSize = 10
        cb.AutoButtonColor = false
        cb.ZIndex = 6
        corner(cb, 8)
        local cbStroke = stroke(cb, StrokeCol, 1, 1)

        cb.BackgroundTransparency = 1
        cb.TextTransparency = 1
        TweenService:Create(cb, TweenInfo.new(0.3),
            { BackgroundTransparency = 0, TextTransparency = 0 }):Play()
        TweenService:Create(cbStroke, TweenInfo.new(0.3), { Transparency = 0.3 }):Play()

        cb.MouseEnter:Connect(function()
            TweenService:Create(cb, TweenInfo.new(0.12),
                { BackgroundColor3 = Color3.fromRGB(22, 22, 22) }):Play()
        end)
        cb.MouseLeave:Connect(function()
            TweenService:Create(cb, TweenInfo.new(0.12), { BackgroundColor3 = Panel }):Play()
        end)

        local resetToken
        cb.MouseButton1Click:Connect(function()
            local copyFn = setclipboard or toclipboard
            local ok = false
            if copyFn then
                ok = pcall(function() copyFn(getText()) end)
            end
            cb.Text = ok and "Copied!" or "Failed"
            cb.TextColor3 = ok and Green or Red
            local token = {}
            resetToken = token
            task.delay(1.4, function()
                if resetToken == token and cb.Parent then
                    cb.Text = "Copy"
                    cb.TextColor3 = TextMid
                end
            end)
        end)
        return cb
    end

    -- ---------- send / clear ----------
    local busy = false

    local function welcome()
        addBubble("ai", "Hi! I'm Johan AI. Ask me anything about Roblox, scripting or this game.", false)
    end

    local function send()
        if busy then
            -- while a reply is being typed out, Send becomes Skip
            if typingNow then skipTyping = true end
            return
        end
        local text = (Input.Text or ""):match("^%s*(.-)%s*$") or ""
        if text == "" then return end
        if #text > 1500 then text = text:sub(1, 1500) end

        -- deduct AI Premium tokens (0.05 – 0.10 cents-style random)
        local okSpend, cost = Shared.spendTokens()
        if not okSpend then
            addBubble("ai", string.format("Out of tokens (need ~%.2f, have %.2f). Refills in 2–4 hours, or ;tokenset / ;tokenreset.", cost or 1, Shared.tokens), true)
            Shared.playTokenEmptyAnim(AiPage)
            return
        end

        Input.Text = ""
        busy = true
        SendBtn.Text = "..."

        addBubble("user", text, false)
        table.insert(history, { role = "user", text = text })
        while #history > 30 do table.remove(history, 1) end
        if history[1] and history[1].role ~= "user" then table.remove(history, 1) end

        local typing = addTyping()
        setTypingStatus(true)
        scrollBottom()

        task.spawn(function()
            local ok, reply, err = pcall(callGemini)
            if not ok then
                err = tostring(reply)
                reply = nil
            end
            if typing.Parent then typing:Destroy() end

            if reply then
                local clean = cleanReply(reply)
                table.insert(history, { role = "model", text = clean })
                local bubble, wrap = addBubble("ai", clean, false)
                SendBtn.Text = "Skip"
                typewrite(bubble)
                if wrap.Parent then
                    addCopyButton(wrap, function() return clean end)
                end
            else
                addBubble("ai", "Error: " .. tostring(err or "Unknown error"), true)
                table.remove(history)   -- drop the failed question
            end

            setTypingStatus(false)
            busy = false
            SendBtn.Text = "Send"
            scrollBottom()
        end)
    end

    SendBtn.MouseButton1Click:Connect(send)
    Input.FocusLost:Connect(function(enterPressed)
        if enterPressed then send() end
    end)

    ClearBtn.MouseButton1Click:Connect(function()
        if busy then return end
        for _, c in ipairs(Chat:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        history = {}
        msgOrder = 0
        welcome()
    end)

    Shared.makeLock(AiPage, "Locked Only Premium🔒", "You need Premium permission to use this tab.",
        function() return not Shared.premium end)

    welcome()
end

-- ===================== COMMANDS (console + chat commands + commands window) =====================
local CommandsPage = (function()
    local SETTINGS_FILE = "AdminPanel_settings.json"
    local function rankName() return Shared.RANK_NAMES[Shared.rank] or "Member" end

    local state = {
        prefix = ";",
        autosave = false,
        chatOn = true,
        ws = nil,
        jp = nil,
        noclipConn = nil,
        noclipToken = 0,
    }
    local conns = {}
    local toggleUpdaters = {}
    local prefixListeners = {}
    local noclipChanged = {}

    local logLine       -- assigned when the console is built
    local openWindow    -- assigned when the commands window is built
    local printList     -- assigned when the commands window is built
    local openRanks     -- assigned when the ranks window is built
    local refreshRanks
    local updateRankTimers

    local function ascii(s)
        return (tostring(s or ""):gsub("[^ -~\n]", "?"))
    end

    local function num(s)
        local n = tonumber(s)
        if not n or n ~= n or n == math.huge or n == -math.huge then return nil end
        return n
    end

    local function validPrefix(p)
        return type(p) == "string" and #p >= 1 and #p <= 3
            and not p:find("[%s%c]") and not p:find("[^ -~]")
    end

    -- ---------- rank grants + saved settings ----------
    -- session = until you leave, perm = saved to a file, temp = expires (never saved)
    local grants = { session = {}, perm = {}, temp = {} }
    local kicklog, banlog = {}, {}

    local function saveSettings()
        if not writefile then return false end
        local ok = pcall(function()
            writefile(SETTINGS_FILE, HttpService:JSONEncode({
                autosave = state.autosave,
                prefix = state.autosave and state.prefix or nil,
                permRanks = grants.perm,
            }))
        end)
        return ok
    end

    local function loadSettings()
        if not (isfile and readfile) then return false end
        local loaded = false
        pcall(function()
            if isfile(SETTINGS_FILE) then
                local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
                if type(data) == "table" then
                    if validPrefix(data.prefix) then
                        state.prefix = data.prefix
                        state.autosave = data.autosave == true
                        loaded = true
                    end
                    if type(data.permRanks) == "table" then
                        for k, g in pairs(data.permRanks) do
                            if type(g) == "table" and (tonumber(g.rank) or g.premium == true) then
                                grants.perm[tostring(k)] = {
                                    rank = tonumber(g.rank),
                                    premium = g.premium == true,
                                    name = tostring(g.name or k),
                                    label = tostring(g.label or ""),
                                }
                            end
                        end
                    end
                end
            end
        end)
        return loaded
    end

    local function setPrefix(p)
        state.prefix = p
        if state.autosave then saveSettings() end
        for _, f in ipairs(prefixListeners) do pcall(f) end
    end

    -- ---------- character helpers ----------
    local function getHum()
        local c = LP.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function startNoclip()
        state.noclipToken += 1
        if state.noclipConn then state.noclipConn:Disconnect() end
        state.noclipConn = RunService.Stepped:Connect(function()
            local ch = LP.Character
            if not ch then return end
            for _, part in ipairs(ch:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    noclipChanged[part] = true
                    part.CanCollide = false
                end
            end
        end)
    end

    local function stopNoclip()
        state.noclipToken += 1
        if state.noclipConn then
            state.noclipConn:Disconnect()
            state.noclipConn = nil
        end
        for part in pairs(noclipChanged) do
            if part.Parent then part.CanCollide = true end
            noclipChanged[part] = nil
        end
    end

    -- ---------- x-ray (see through walls, only for you) ----------
    local xrayParts = setmetatable({}, { __mode = "k" })
    local xrayConn = nil
    local xrayToken = 0

    local function xrayTouch(part)
        if not part:IsA("BasePart") or part:IsA("Terrain") then return end
        if part.Transparency >= 1 then return end
        local m = part:FindFirstAncestorOfClass("Model")
        if m and m:FindFirstChildOfClass("Humanoid") then return end   -- leave characters alone
        xrayParts[part] = true
        part.LocalTransparencyModifier = 0.65
    end

    local function startXray()
        xrayToken += 1
        local token = xrayToken
        if xrayConn then xrayConn:Disconnect() end
        xrayConn = workspace.DescendantAdded:Connect(xrayTouch)
        task.spawn(function()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if xrayToken ~= token then return end
                xrayTouch(d)
                n += 1
                if n % 300 == 0 then task.wait() end    -- in small chunks so nothing freezes
            end
        end)
    end

    local function stopXray()
        xrayToken += 1
        if xrayConn then
            xrayConn:Disconnect()
            xrayConn = nil
        end
        for part in pairs(xrayParts) do
            if part.Parent then part.LocalTransparencyModifier = 0 end
            xrayParts[part] = nil
        end
    end

    -- ---------- spin ----------
    local spinConn = nil

    local function stopSpin()
        if spinConn then
            spinConn:Disconnect()
            spinConn = nil
        end
    end

    local function startSpin(speed)
        stopSpin()
        spinConn = RunService.Heartbeat:Connect(function(dt)
            local ch = LP.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            if root then
                root.CFrame = root.CFrame * CFrame.Angles(0, speed * dt, 0)
            end
        end)
    end

    -- ---------- roles, times and targets for the rank commands ----------
    local ROLE_HELP = "Member, Premium, Mod, Admin, HeadAdmin, Co-owner, Owner"
    local ROLE_ALIASES = {
        member = 1, members = 1,
        mod = 2, mods = 2, moderator = 2,
        admin = 3,
        headadmin = 4, head = 4,
        coowner = 5,
        owner = 6,
    }

    -- returns { rank = n } or { premium = true }, plus a label; nil if the name is unknown
    local function parseRole(text)
        if not text then return nil end
        local key = (text:lower():gsub("[%-_%s]", ""))
        if key == "premium" then return { premium = true, label = "Premium" } end
        local r = ROLE_ALIASES[key]
        if r then return { rank = r, label = Shared.RANK_NAMES[r] } end
        return nil
    end

    local UNITS = {
        [""] = 1, s = 1, sec = 1, secs = 1, second = 1, seconds = 1,
        ms = 0.001, msec = 0.001, millisecond = 0.001, milliseconds = 0.001,
        milisecond = 0.001, miliseconds = 0.001,
        m = 60, min = 60, mins = 60, minute = 60, minutes = 60,
        h = 3600, hr = 3600, hrs = 3600, hour = 3600, hours = 3600, hout = 3600,
        d = 86400, day = 86400, days = 86400,
    }

    -- "30" = 30 seconds, "5m", "1 hour", "250ms" ... returns seconds or nil
    local function parseDuration(a, b)
        if not a then return nil end
        local numStr, unit = a:match("^(%d+%.?%d*)(%a*)$")
        if not numStr then return nil end
        if unit == "" and b and UNITS[b:lower()] then unit = b end
        local mult = UNITS[unit:lower()]
        local n = tonumber(numStr)
        if not mult or not n then return nil end
        local secs = n * mult
        if secs <= 0 then return nil end
        return math.min(secs, 30 * 86400)
    end

    local function fmtDuration(s)
        if s < 1 then return math.floor(s * 1000 + 0.5) .. "ms" end
        if s < 60 then return (math.floor(s * 10 + 0.5) / 10) .. "s" end
        if s < 3600 then return math.floor(s / 60) .. "m " .. math.floor(s % 60) .. "s" end
        if s < 86400 then return math.floor(s / 3600) .. "h " .. math.floor((s % 3600) / 60) .. "m" end
        return math.floor(s / 86400) .. "d " .. math.floor((s % 86400) / 3600) .. "h"
    end

    -- user can be a name, a display name, a user id, or "me". Returns id, name (or nil, error)
    local function resolveTarget(text)
        if not text or text == "" then return nil, "Missing user (name or id)" end
        local q = text:lower()
        if q == "me" then return LP.UserId, LP.Name end
        local best
        for _, pl in ipairs(Players:GetPlayers()) do
            local n, d = pl.Name:lower(), pl.DisplayName:lower()
            if n == q or d == q or tostring(pl.UserId) == q then return pl.UserId, pl.Name end
            if not best and (n:sub(1, #q) == q or d:sub(1, #q) == q) then best = pl end
        end
        if best then return best.UserId, best.Name end
        local id = tonumber(text)
        if id and id > 0 and id % 1 == 0 then
            local ok, name = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
            if ok and name then return id, name end
            return nil, "No Roblox user has the id " .. text
        end
        local ok, uid = pcall(function() return Players:GetUserIdFromNameAsync(text) end)
        if ok and uid then return uid, text end
        return nil, "Could not find the user: " .. ascii(text)
    end

    local function grantRankOf(key)
        local best = 0
        for _, tbl in pairs(grants) do
            local g = tbl[key]
            if g and g.rank and g.rank > best then best = g.rank end
        end
        return best
    end

    -- your own grants change your effective rank
    local function syncMyGrants()
        local myKey = tostring(LP.UserId)
        local bestRank, prem = 0, false
        for _, tbl in pairs(grants) do
            local g = tbl[myKey]
            if g then
                if g.rank and g.rank > bestRank then bestRank = g.rank end
                if g.premium then prem = true end
            end
        end
        Shared.grantRank = bestRank
        Shared.grantPremium = prem
        Shared.recompute()
        if refreshRanks then refreshRanks() end
    end

    -- you can only hand out ranks below your own (Owners can hand out Owner)
    local function checkGrantAllowed(uid, name, role)
        local mine, top = Shared.rank, #Shared.RANK_NAMES
        if role.rank and (role.rank > mine or (role.rank == mine and mine < top)) then
            return false, "You can only give ranks below your own (" .. rankName() .. ")"
        end
        if tostring(uid) ~= tostring(LP.UserId) and mine < top and grantRankOf(tostring(uid)) >= mine then
            return false, "You can't change " .. ascii(name) .. " (their rank is equal to or higher than yours)"
        end
        return true
    end

    local function checkRemoveAllowed(uid, name)
        local mine, top = Shared.rank, #Shared.RANK_NAMES
        if tostring(uid) ~= tostring(LP.UserId) and mine < top and grantRankOf(tostring(uid)) >= mine then
            return false, "You can't change " .. ascii(name) .. " (their rank is equal to or higher than yours)"
        end
        return true
    end

    local function applyGrant(tbl, uid, name, role, extra)
        local key = tostring(uid)
        local g = tbl[key] or {}
        g.name = name
        if role.rank then g.rank = role.rank end
        if role.premium then g.premium = true end
        g.label = role.label
        for k, v in pairs(extra or {}) do g[k] = v end
        tbl[key] = g
        return g
    end

    local function noteFor(uid)
        if tostring(uid) ~= tostring(LP.UserId) then
            return "  [recorded in your panel only]"
        end
        return ""
