    -- emoji / odd unicode and markdown can break or clutter labels, so tidy replies
    local function cleanReply(s)
        s = tostring(s or "")
        s = s:gsub("\r", "")
        s = s:gsub("[\240-\247][\128-\191]*", "")
        s = s:gsub("\226\128\141", "")
        s = s:gsub("\239\184\143", "")
        s = s:gsub("```%w*\n?", "")
        s = s:gsub("%*%*(.-)%*%*", "%1")
        s = s:gsub("\n#+%s*", "\n")
        s = s:gsub("^#+%s*", "")
        s = s:gsub("\n%s*%*%s+", "\n- ")
        s = s:gsub("`", "")
        s = s:gsub("\n\n\n+", "\n\n")
        s = s:match("^%s*(.-)%s*$") or s
        if #s > 6000 then s = s:sub(1, 6000) .. "..." end
        if s == "" then s = "(empty reply)" end
        return s
    end

    -- ---------- Gemini ----------
    local function httpPostJSON(url, payload)
        local req = (syn and syn.request)
            or (http and http.request)
            or http_request
            or request
            or (fluxus and fluxus.request)

        local function decode(body)
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok then return data end
            return nil
        end

        if req then
            local ok, res = pcall(function()
                return req({
                    Url = url,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = payload,
                })
            end)
            if ok and type(res) == "table" and type(res.Body) == "string" then
                return decode(res.Body), tonumber(res.StatusCode) or 0
            end
            return nil, 0
        end

        local ok2, body = pcall(function()
            return game:HttpPost(url, payload, "application/json")
        end)
        if ok2 and type(body) == "string" then return decode(body), 200 end
        return nil, 0
    end

    local function postWithTimeout(url, payload, secs)
        local done, data, status = false, nil, 0
        task.spawn(function()
            data, status = httpPostJSON(url, payload)
            done = true
        end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < secs do task.wait(0.1) end
        if not done then return nil, -1 end
        return data, status
    end

    local function routeUrl(host, model)
        if host == "studio" then
            return "https://generativelanguage.googleapis.com/v1beta/models/"
                .. model .. ":generateContent?key=" .. GEMINI_API_KEY
        end
        return "https://aiplatform.googleapis.com/v1/publishers/google/models/"
            .. model .. ":generateContent?key=" .. GEMINI_API_KEY
    end

    local function extractText(data)
        local c = data and data.candidates and data.candidates[1]
        local parts = c and c.content and c.content.parts
        if type(parts) ~= "table" then return nil end
        local out = {}
        for _, part in ipairs(parts) do
            if type(part.text) == "string" then table.insert(out, part.text) end
        end
        if #out == 0 then return nil end
        return table.concat(out)
    end

    local function errorOf(data)
        local e = data and (data.error or (data[1] and data[1].error))
        if type(e) == "table" and e.message then return tostring(e.message) end
        return nil
    end

    -- Google issues two key styles (AI Studio and Vertex express, both can start with
    -- "AQ."), so try both hosts and remember whichever one works.
    local workingRoute = nil

    local function callGemini()
        if GEMINI_API_KEY == "" then return nil, "No API key set" end

        local contents = {}
        for _, h in ipairs(history) do
            table.insert(contents, { role = h.role, parts = { { text = h.text } } })
        end
        local payload = HttpService:JSONEncode({
            systemInstruction = { parts = { { text = SYSTEM_PROMPT } } },
            contents = contents,
            generationConfig = { temperature = 0.7, maxOutputTokens = 2048 },
        })

        local routes = {}
        if workingRoute then table.insert(routes, workingRoute) end
        for _, m in ipairs(MODELS) do
            for _, h in ipairs({ "studio", "vertex" }) do
                local dup = workingRoute and workingRoute.host == h and workingRoute.model == m
                if not dup then table.insert(routes, { host = h, model = m }) end
            end
        end

        local lastErr = "Couldn't reach Gemini. Check your connection."
        for _, r in ipairs(routes) do
            local data, status = postWithTimeout(routeUrl(r.host, r.model), payload, 25)
            status = tonumber(status) or 0

            if status == -1 then
                return nil, "Request timed out. Try again."
            end

            if data and status >= 200 and status < 300 then
                local text = extractText(data)
                if text then
                    workingRoute = r
                    return text
                end
                local block = data.promptFeedback and data.promptFeedback.blockReason
                return nil, block and ("Blocked: " .. tostring(block)) or "Empty reply, try rephrasing."
            end

            if status == 429 then
                return nil, "Rate limit reached. Wait a moment and try again."
            end

            local msg = errorOf(data)
            if msg then
                lastErr = cleanReply(msg)
                if #lastErr > 160 then lastErr = lastErr:sub(1, 157) .. "..." end
            end
        end
        return nil, lastErr
    end

    -- one-shot Gemini call used by the GUI Builder (returns text, or nil and an error)
    function Shared.gemini(systemText, userText, maxTokens)
        if GEMINI_API_KEY == "" then return nil, "No API key set" end
        local payload = HttpService:JSONEncode({
            systemInstruction = { parts = { { text = systemText } } },
            contents = { { role = "user", parts = { { text = userText } } } },
            generationConfig = { temperature = 0.4, maxOutputTokens = maxTokens or 4096 },
        })

        local routes = {}
        if workingRoute then table.insert(routes, workingRoute) end
        for _, m in ipairs(MODELS) do
            for _, h in ipairs({ "studio", "vertex" }) do
                local dup = workingRoute and workingRoute.host == h and workingRoute.model == m
                if not dup then table.insert(routes, { host = h, model = m }) end
            end
        end

        local lastErr = "Couldn't reach Gemini. Check your connection."
        for _, r in ipairs(routes) do
            local data, status = postWithTimeout(routeUrl(r.host, r.model), payload, 60)
            status = tonumber(status) or 0
            if status == -1 then
                return nil, "Request timed out. Try again."
            end
            if data and status >= 200 and status < 300 then
                local text = extractText(data)
                if text then
                    workingRoute = r
                    return text
                end
                return nil, "Empty reply, try rephrasing."
            end
            if status == 429 then
                return nil, "Rate limit reached. Wait a moment and try again."
            end
            local msg = errorOf(data)
            if msg then
                lastErr = cleanReply(msg)
                if #lastErr > 160 then lastErr = lastErr:sub(1, 157) .. "..." end
            end
        end
        return nil, lastErr
    end

