local function pulseGlow(dot, baseSize)
    baseSize = baseSize or 8
    task.spawn(function()
        local t = 0
        while dot.Parent do
            t += RunService.Heartbeat:Wait()
            local wave = (math.sin(t * 2.2) + 1) * 0.5
            local size = baseSize + wave * 3
            local alpha = 0.45 + wave * 0.35
            dot.Size = UDim2.new(0, size, 0, size)
            dot.BackgroundTransparency = alpha
        end
    end)
end

