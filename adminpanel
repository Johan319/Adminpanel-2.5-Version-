    local function bust()
        return tostring(os.clock()):gsub("%.", "") .. "_" .. tostring(math.random(1000, 9999))
    end

    local function fetchMessages()
        local url = CHAT_BASE .. ROOM .. ".json?bust=" .. bust()
        local body = nil
        pcall(function()
            if game.HttpGet then body = game:HttpGet(url) end
        end)
        if not body then
            local res = select(1, httpRequest("GET", url, nil))
            if res then body = res.Body or res.body end
        end
        if not body or body == "null" or body == "" then return end
        local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or type(data) ~= "table" then return end

        local list = {}
        for id, msg in pairs(data) do
            if type(msg) == "table" and (msg.text or msg.imgUrl) then
                list[#list + 1] = { id = tostring(id), msg = msg }
            end
        end
        table.sort(list, function(a, b)
            return (tonumber(a.msg.timestamp) or 0) < (tonumber(b.msg.timestamp) or 0)
        end)
        if #list > MAX_SHOW then
            local cut = {}
            for i = #list - MAX_SHOW + 1, #list do cut[#cut + 1] = list[i] end
            list = cut
        end
        for _, item in ipairs(list) do
            if not seen[item.id] then
                seen[item.id] = true
                local m = item.msg
                local uid = tonumber(m.userId)
                local banned = uid and Shared.chatBans and Shared.chatBans[uid]
                local isMe = (uid and uid == LP.UserId) or tostring(m.sender) == LP.Name
                if banned and not isMe then
                    -- skip for everyone else
                else
                    local isSys = m.isSystem == true or m.isJoin == true
                    local img = (m.isImg and m.imgUrl) and tostring(m.imgUrl) or (m.imgUrl and tostring(m.imgUrl) or "")
                    if img == "" then img = nil end
                    local rk = 1
                    if isMe then
                        rk = Shared.rank or 1
                    elseif Shared.rankOf then
                        rk = math.max(tonumber(m.rank) or 1, Shared.rankOf(uid) or 1)
                    else
                        rk = tonumber(m.rank) or 1
                    end
                    addBubble(m.sender, m.displayName or m.sender, m.text, isMe, isSys, img, uid, rk)
                end
            end
        end
    end

    local function postPayload(payloadTable)
        local payload = HttpService:JSONEncode(payloadTable)
        local url = CHAT_BASE .. ROOM .. ".json"
        local res = select(1, httpRequest("POST", url, payload))
        return httpOk(res)
    end

    local function sendMessage(text, imgUrl)
        if Shared.isChatBanned and Shared.isChatBanned(LP.UserId) then
            if showToast then showToast("Chat", "You are chat-banned", "error") end
            return
        end
        text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        imgUrl = imgUrl and tostring(imgUrl) or ""
        if text == "" and imgUrl == "" then return end
        if #text > 300 then text = text:sub(1, 300) end
        if tick() - lastSend < 1.0 then
            if showToast then showToast("Chat", "Slow down", "error") end
            return
        end
        lastSend = tick()
        local isImg = imgUrl ~= ""
        task.spawn(function()
            local ok = postPayload({
                sender = LP.Name,
                displayName = LP.DisplayName,
                text = isImg and (text ~= "" and text or "[Image]") or text,
                isImg = isImg,
                imgUrl = imgUrl,
                isJoin = false,
                isSystem = false,
                timestamp = os.time(),
                placeId = game.PlaceId,
                userId = LP.UserId,
                rank = math.max(1, tonumber(Shared.rank) or 1),
            })
            if not ok then
                if showToast then showToast("Chat", "Send failed", "error") end
            else
                chatBox.Text = ""
                task.wait(0.3)
                pcall(fetchMessages)
            end
        end)
    end

