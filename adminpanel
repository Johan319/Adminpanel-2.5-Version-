local function makeIcon(parent, kind)
    local box = Instance.new("Frame", parent)
    box.BackgroundTransparency = 1
    box.Position = UDim2.new(0, 12, 0.5, -8)
    box.Size = UDim2.new(0, 16, 0, 16)
    box.ZIndex = 5
    box.Active = false

    local function part(px, py, sx, sy, col, rot, rad)
        local f = Instance.new("Frame", box)
        f.BackgroundColor3 = col or TextMid
        f.BorderSizePixel = 0
        f.Active = false
        f.Position = UDim2.new(0, px, 0, py)
        f.Size = UDim2.new(0, sx, 0, sy)
        if rot then f.Rotation = rot end
        f.ZIndex = 6
        corner(f, rad or 1)
        return f
    end

    local function outline(px, py, sx, sy, col, rad)
        local f = Instance.new("Frame", box)
        f.BackgroundTransparency = 1
        f.Position = UDim2.new(0, px, 0, py)
        f.Size = UDim2.new(0, sx, 0, sy)
        f.ZIndex = 6
        corner(f, rad or 2)
        stroke(f, col or TextMid, 1.5)
        return f
    end

    if kind == "overview" then
        outline(1, 1, 6, 6, TextMid, 2)
        outline(9, 1, 6, 6, TextMid, 2)
        outline(1, 9, 6, 6, TextMid, 2)
        outline(9, 9, 6, 6, TextMid, 2)
    elseif kind == "shield" then
        -- vector shield (same style as other tab icons)
        outline(2, 1, 12, 10, TextMid, 3)
        outline(8, 11, 8, 8, TextMid, 2)
        part(7, 4, 2, 6, TextMid, 0, 1)
        part(5, 8, 6, 2, TextMid, 0, 1)
    elseif kind == "chat" then
        outline(1, 2, 14, 10, TextMid, 3)
        part(4, 6, 2, 2, TextMid, 0, 1)
        part(7, 6, 2, 2, TextMid, 0, 1)
        part(10, 6, 2, 2, TextMid, 0, 1)
    elseif kind == "players" then
        outline(1, 1, 6, 6, TextMid, 3)
        outline(5, 2, 6, 6, TextMid, 3)
        outline(9, 1, 6, 6, TextMid, 3)
        outline(1, 8, 6, 4, TextMid, 2)
        outline(5, 9, 6, 4, TextMid, 2)
        outline(9, 8, 6, 4, TextMid, 2)
    elseif kind == "info" then
        outline(1, 3, 14, 10, TextMid, 2)
        outline(3, 5, 5, 6, TextMid, 1)
        part(9, 6, 4, 1, TextMid, 0, 1)
        part(9, 8, 4, 1, TextMid, 0, 1)
        part(9, 10, 3, 1, TextMid, 0, 1)
    elseif kind == "games" then
        -- controller / gamepad style (different from scriptblox list icon)
        outline(1, 4, 14, 9, TextMid, 3)
        part(4, 7, 2, 2, TextMid, 0, 1)
        part(10, 7, 2, 2, TextMid, 0, 1)
        part(7, 6, 2, 1, TextMid, 0, 1)
        part(7, 9, 2, 1, TextMid, 0, 1)
    elseif kind == "scriptblox" then
        outline(2, 2, 12, 13, TextMid, 2)
        part(4, 5, 5, 1, TextMid, 0, 1)
        part(4, 8, 7, 1, TextMid, 0, 1)
        part(4, 11, 5, 1, TextMid, 0, 1)
    elseif kind == "ai" then
        outline(1, 1, 14, 10, TextMid, 4)
        part(4, 10, 3, 3, TextMid, 45, 1)
        part(7, 3, 2, 6, TextMid, 0, 1)
        part(5, 5, 6, 2, TextMid, 0, 1)
    elseif kind == "commands" then
        outline(1, 2, 14, 12, TextMid, 3)
        part(4, 5, 4, 1, TextMid, 40, 1)
        part(4, 8, 4, 1, TextMid, -40, 1)
        part(9, 10, 4, 1, TextMid, 0, 1)
    elseif kind == "builder" then
        outline(1, 1, 14, 14, TextMid, 3)
        part(7, 4, 2, 8, TextMid, 0, 1)
        part(4, 7, 8, 2, TextMid, 0, 1)
    elseif kind == "credits" then
        part(7, 1, 2, 14, TextMid, 0, 1)
        part(1, 7, 14, 2, TextMid, 0, 1)
        part(3, 7, 10, 2, TextMid, 45, 1)
        part(3, 7, 10, 2, TextMid, -45, 1)
    elseif kind == "discord" then
        outline(1, 2, 14, 11, Accent, 4)
        local tail = Instance.new("Frame", box)
        tail.BackgroundColor3 = Accent
        tail.BorderSizePixel = 0
        tail.Position = UDim2.new(0, 4, 0, 13)
        tail.Size = UDim2.new(0, 4, 0, 3)
        tail.Rotation = 45
