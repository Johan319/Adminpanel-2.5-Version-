    -- Push rank grants to other people running THIS same panel (same server)
    local RANK_TAG = "APRANK|"
    local function isTrustedRankSender(userId)
        userId = tonumber(userId)
        if not userId then return false end
        for _, listName in ipairs({ "Owner", "Co-owner", "HeadAdmin" }) do
            local list = Shared.RANK_IDS[listName]
            if list and table.find(list, userId) then return true end
        end
        -- also trust the local owner id baked into the script
        if userId == 8992189635 then return true end
        return false
    end

    local function sendRankPacket(payload)
        local packet = RANK_TAG .. HttpService:JSONEncode(payload)
        pcall(function()
            local TCS = game:GetService("TextChatService")
            local channels = TCS:FindFirstChild("TextChannels")
            local ch = channels and (channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel"))
            if ch and ch.SendAsync then
                ch:SendAsync(packet)
                return
            end
        end)
        pcall(function()
            local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
            local say = ev and ev:FindFirstChild("SayMessageRequest")
            if say then say:FireServer(packet, "All") end
        end)
    end

    local function pushRankToTarget(uid, kind, role, extra)
        if tostring(uid) == tostring(LP.UserId) then return end
        sendRankPacket({
            uid = uid,
            kind = kind, -- "session" | "temp" | "perm" | "remove_session" | "remove_temp" | "remove_perm"
            rank = role and role.rank or nil,
            premium = role and role.premium or false,
            label = role and role.label or nil,
            expiresIn = extra and extra.expiresIn or nil,
            from = LP.UserId,
            fromName = LP.Name,
        })
    end

    local function applyIncomingRank(data)
        if type(data) ~= "table" then return end
        if tonumber(data.uid) ~= LP.UserId then return end
        if not isTrustedRankSender(data.from) then return end
        local kind = tostring(data.kind or "")
        local key = tostring(LP.UserId)
        if kind == "remove_session" then
            grants.session[key] = nil
        elseif kind == "remove_temp" then
            grants.temp[key] = nil
        elseif kind == "remove_perm" then
            grants.perm[key] = nil
            saveSettings()
        elseif kind == "session" or kind == "temp" or kind == "perm" then
            local role = { rank = tonumber(data.rank), premium = data.premium and true or false, label = data.label or "rank" }
            if not role.rank and not role.premium then return end
            local tbl = grants.session
            if kind == "temp" then tbl = grants.temp end
            if kind == "perm" then tbl = grants.perm end
            local extra = {}
            if kind == "temp" and data.expiresIn then
                extra.expires = os.clock() + tonumber(data.expiresIn)
                task.delay(tonumber(data.expiresIn) + 0.05, expireTemps)
            end
            applyGrant(tbl, LP.UserId, LP.Name, role, extra)
            if kind == "perm" then saveSettings() end
            if showToast then
                showToast("Rank", "You are now " .. tostring(role.label or "ranked") .. " (from " .. tostring(data.fromName or "?") .. ")", "success")
            end
        else
            return
        end
        Shared._rankReady = true
        syncMyGrants()
        if logLine then
            logLine("Rank update applied from " .. tostring(data.fromName or data.from), "ok")
        end
    end

    local function onRankMessage(raw, fromPlayer)
        if type(raw) ~= "string" or raw:sub(1, #RANK_TAG) ~= RANK_TAG then return end
        local ok, data = pcall(function() return HttpService:JSONDecode(raw:sub(#RANK_TAG + 1)) end)
        if not ok or type(data) ~= "table" then return end
        if fromPlayer then data.from = fromPlayer.UserId; data.fromName = fromPlayer.Name end
        applyIncomingRank(data)
    end

    task.spawn(function()
        pcall(function()
            local TCS = game:GetService("TextChatService")
            pcall(function()
                TCS.MessageReceived:Connect(function(msg)
                    local src = nil
                    pcall(function()
