function Shared.rankOf(uid)
    uid = tonumber(uid)
    if not uid then return 1 end
    if uid == LP.UserId then
        return math.max(1, tonumber(Shared.rank) or 1)
    end
    local best = 1
    for i, rankName in ipairs(Shared.RANK_NAMES or {}) do
        local list = Shared.RANK_IDS and Shared.RANK_IDS[rankName]
        if list and table.find(list, uid) and i > best then
            best = i
        end
    end
    return best
end

function Shared.isChatBanned(uid)
    uid = tonumber(uid)
    return uid ~= nil and Shared.chatBans[uid] ~= nil
end

-- ===================== HTTP HELPERS =====================
local function httpGet(url)
    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if req then
        local ok, res = pcall(function()
            return req({ Url = url, Method = "GET" })
        end)
        if ok and type(res) == "table" and type(res.Body) == "string" then
            local code = res.StatusCode or 200
            if code >= 200 and code < 300 then
                return res.Body
            end
        end
    end
    local ok2, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok2 and type(body) == "string" then return body end
    return nil
end

local function safeExecute(code)
    local ls = loadstring or (getgenv and getgenv().loadstring)
    if not ls then return false, "No loadstring" end
    local fn, compileErr = ls(code)
    if type(fn) ~= "function" then
        return false, "Compile Error: " .. tostring(compileErr)
    end
    local ok, runErr = pcall(fn)
    if not ok then return false, "Runtime Error: " .. tostring(runErr) end
    return true, "Executed"
end

