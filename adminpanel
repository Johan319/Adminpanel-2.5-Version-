    -- ===== VANISH (Admin): teleport high + float frozen (still visible) =====
    local vanishState = {
        on = false,
        savedCF = nil,
        floatConn = nil,
        charConn = nil,
        holdCF = nil,
    }

    local function stopVanishFloat()
        if vanishState.floatConn then
            vanishState.floatConn:Disconnect()
            vanishState.floatConn = nil
        end
    end

    local function freezeHumanoid(char, freeze)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(function()
            if freeze then
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
                hum.PlatformStand = true
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            else
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end

    local function startVanishFloat(root)
        stopVanishFloat()
        if not root then return end
        local pos = root.Position
        -- teleport much higher and hold still (visible, looks floating / stuck)
        local floatY = math.max(pos.Y + 320, 420)
        local hold = CFrame.new(pos.X, floatY, pos.Z)
        vanishState.holdCF = hold
        root.CFrame = hold
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        freezeHumanoid(root.Parent, true)
        vanishState.floatConn = RunService.Heartbeat:Connect(function()
            if not vanishState.on then return end
            local char = LP.Character
            local r = char and char:FindFirstChild("HumanoidRootPart")
            if not r or not vanishState.holdCF then return end
            r.CFrame = vanishState.holdCF
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
            freezeHumanoid(char, true)
        end)
    end

    local function vanishOff()
        if not vanishState.on then return false end
        vanishState.on = false
        stopVanishFloat()
        if vanishState.charConn then
            vanishState.charConn:Disconnect()
            vanishState.charConn = nil
        end
        local char = LP.Character
        freezeHumanoid(char, false)
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and vanishState.savedCF then
            root.CFrame = vanishState.savedCF
            root.AssemblyLinearVelocity = Vector3.zero
        end
        vanishState.savedCF = nil
        vanishState.holdCF = nil
        return true
    end

    local function vanishOn()
        if vanishState.on then return false, "Already vanished — use ;unvanish" end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return false, "No character" end
        vanishState.savedCF = root.CFrame
        vanishState.on = true
        startVanishFloat(root)
        if vanishState.charConn then vanishState.charConn:Disconnect() end
        vanishState.charConn = LP.CharacterAdded:Connect(function(newChar)
            if not vanishState.on then return end
            task.wait(0.35)
            local r = newChar:FindFirstChild("HumanoidRootPart") or newChar:WaitForChild("HumanoidRootPart", 5)
            if r and vanishState.on then
                startVanishFloat(r)
            end
        end)
        return true
    end

