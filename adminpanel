    -- ---------- roles, times and targets for the rank commands ----------
    local ROLE_HELP = "Member, Premium, Mod, Admin, HeadAdmin, Co-owner, Owner"
    local ROLE_ALIASES = {
        member = 1, members = 1,
        mod = 2, mods = 2, moderator = 2,
        admin = 3,
        headadmin = 4, head = 4,
        coowner = 5,
        owner = 6,
    }

    -- returns { rank = n } or { premium = true }, plus a label; nil if the name is unknown
    local function parseRole(text)
        if not text then return nil end
        local key = (text:lower():gsub("[%-_%s]", ""))
        if key == "premium" then return { premium = true, label = "Premium" } end
        local r = ROLE_ALIASES[key]
        if r then return { rank = r, label = Shared.RANK_NAMES[r] } end
        return nil
    end

    local UNITS = {
        [""] = 1, s = 1, sec = 1, secs = 1, second = 1, seconds = 1,
        ms = 0.001, msec = 0.001, millisecond = 0.001, milliseconds = 0.001,
        milisecond = 0.001, miliseconds = 0.001,
        m = 60, min = 60, mins = 60, minute = 60, minutes = 60,
        h = 3600, hr = 3600, hrs = 3600, hour = 3600, hours = 3600, hout = 3600,
        d = 86400, day = 86400, days = 86400,
    }

    -- "30" = 30 seconds, "5m", "1 hour", "250ms" ... returns seconds or nil
    local function parseDuration(a, b)
        if not a then return nil end
        local numStr, unit = a:match("^(%d+%.?%d*)(%a*)$")
        if not numStr then return nil end
        if unit == "" and b and UNITS[b:lower()] then unit = b end
        local mult = UNITS[unit:lower()]
        local n = tonumber(numStr)
        if not mult or not n then return nil end
        local secs = n * mult
        if secs <= 0 then return nil end
        return math.min(secs, 30 * 86400)
    end

    local function fmtDuration(s)
        if s < 1 then return math.floor(s * 1000 + 0.5) .. "ms" end
        if s < 60 then return (math.floor(s * 10 + 0.5) / 10) .. "s" end
        if s < 3600 then return math.floor(s / 60) .. "m " .. math.floor(s % 60) .. "s" end
        if s < 86400 then return math.floor(s / 3600) .. "h " .. math.floor((s % 3600) / 60) .. "m" end
        return math.floor(s / 86400) .. "d " .. math.floor((s % 86400) / 3600) .. "h"
    end

    -- user can be a name, a display name, a user id, or "me". Returns id, name (or nil, error)
    local function resolveTarget(text)
        if not text or text == "" then return nil, "Missing user (name or id)" end
        local q = text:lower()
        if q == "me" then return LP.UserId, LP.Name end
        local best
        for _, pl in ipairs(Players:GetPlayers()) do
            local n, d = pl.Name:lower(), pl.DisplayName:lower()
            if n == q or d == q or tostring(pl.UserId) == q then return pl.UserId, pl.Name end
            if not best and (n:sub(1, #q) == q or d:sub(1, #q) == q) then best = pl end
        end
        if best then return best.UserId, best.Name end
        local id = tonumber(text)
        if id and id > 0 and id % 1 == 0 then
            local ok, name = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
            if ok and name then return id, name end
            return nil, "No Roblox user has the id " .. text
        end
        local ok, uid = pcall(function() return Players:GetUserIdFromNameAsync(text) end)
        if ok and uid then return uid, text end
        return nil, "Could not find the user: " .. ascii(text)
    end

    local function grantRankOf(key)
        local best = 0
        for _, tbl in pairs(grants) do
            local g = tbl[key]
            if g and g.rank and g.rank > best then best = g.rank end
        end
        return best
    end

    -- your own grants change your effective rank
    local function syncMyGrants()
        local myKey = tostring(LP.UserId)
        local bestRank, prem = 0, false
        for _, tbl in pairs(grants) do
            local g = tbl[myKey]
            if g then
                if g.rank and g.rank > bestRank then bestRank = g.rank end
                if g.premium then prem = true end
            end
        end
        Shared.grantRank = bestRank
        Shared.grantPremium = prem
        Shared.recompute()
        if refreshRanks then refreshRanks() end
    end

    -- you can only hand out ranks below your own (Owners can hand out Owner)
    local function checkGrantAllowed(uid, name, role)
        local mine, top = Shared.rank, #Shared.RANK_NAMES
        if role.rank and (role.rank > mine or (role.rank == mine and mine < top)) then
            return false, "You can only give ranks below your own (" .. rankName() .. ")"
        end
        if tostring(uid) ~= tostring(LP.UserId) and mine < top and grantRankOf(tostring(uid)) >= mine then
            return false, "You can't change " .. ascii(name) .. " (their rank is equal to or higher than yours)"
        end
        return true
    end

    local function checkRemoveAllowed(uid, name)
        local mine, top = Shared.rank, #Shared.RANK_NAMES
        if tostring(uid) ~= tostring(LP.UserId) and mine < top and grantRankOf(tostring(uid)) >= mine then
            return false, "You can't change " .. ascii(name) .. " (their rank is equal to or higher than yours)"
        end
        return true
    end

    local function applyGrant(tbl, uid, name, role, extra)
        local key = tostring(uid)
        local g = tbl[key] or {}
        g.name = name
        if role.rank then g.rank = role.rank end
        if role.premium then g.premium = true end
        g.label = role.label
        for k, v in pairs(extra or {}) do g[k] = v end
        tbl[key] = g
