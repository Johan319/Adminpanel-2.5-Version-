        fn = function(a)
            if not a[1] then
                return false, "Usage: addgames [PlaceId] [text]   example: addgames 12345678 BedWars"
            end
            local id = tonumber(a[1])
            if not id then return false, "Place ID must be a number" end
            local textParts = {}
            for i = 2, #a do textParts[#textParts + 1] = a[i] end
            local label = table.concat(textParts, " ")
            if label == "" then label = "Game " .. tostring(id) end
            Shared.supportedGames = Shared.supportedGames or {}
            -- update if same id exists
            local found = false
            for _, g in ipairs(Shared.supportedGames) do
                if g.id == id then
                    g.text = label
                    found = true
                    break
                end
            end
            if not found then
                Shared.supportedGames[#Shared.supportedGames + 1] = { id = id, text = label }
            end
            if Shared.saveSupportedGames then Shared.saveSupportedGames() end
            if Shared.refreshSupportedGamesUI then Shared.refreshSupportedGamesUI() end
            for _, f in ipairs(Shared.supportedGamesListeners or {}) do pcall(f) end
            return true, string.format("Supported Games: ID %d — %s", id, label)
        end,
    })

