    local vault = { items = {}, favs = {} } -- items: { url, name, fav }

    local function loadVault()
        local loaded = false
        if readfile and isfile then
            pcall(function()
                if isfile(VAULT_FILE) then
                    local d = HttpService:JSONDecode(readfile(VAULT_FILE))
                    if type(d) == "table" then
                        vault.items = type(d.items) == "table" and d.items or {}
                        vault.favs = type(d.favs) == "table" and d.favs or {}
                        loaded = #vault.items > 0
                    end
                end
            end)
        end
        -- seed gallery with GIFs / images from the chat pack when empty
        if not loaded or #vault.items == 0 then
            vault.items = {}
            for _, it in ipairs(DEFAULT_GIFS) do
                vault.items[#vault.items + 1] = { url = it.url, name = it.name, t = it.t, preset = true }
            end
        end
    end
    local function saveVault()
        if not writefile then return end
        pcall(function()
            writefile(VAULT_FILE, HttpService:JSONEncode(vault))
        end)
    end
