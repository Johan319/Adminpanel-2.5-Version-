-- Prop place logic from user paste (Kill All / Bring All Players Props)
local AdminAbusePage
do
    local RS = game:GetService("ReplicatedStorage")
    local propAmount = 15

    local function clearAllProps()
        pcall(function()
            local RE = RS:FindFirstChild("RE")
            local clear = RE and RE:FindFirstChild("1Clea1rTool1s")
            if clear then
                clear:FireServer("ClearAllProps")
            end
        end)
    end

    local function getBaseplate()
        local ok, bp = pcall(function()
            return workspace:WaitForChild("__DEV", 5)
                :WaitForChild("SwappableWorld", 5)
                :WaitForChild("SideArea", 5)
                :WaitForChild("ToBeSwapped", 5)
                :WaitForChild("Baseplate", 5)
        end)
        return ok and bp or nil
    end

    local function countMyProps()
        local n = 0
        pcall(function()
            local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
            if not workspaceCom then return end
            for _, folder in ipairs(workspaceCom:GetChildren()) do
                for _, prop in ipairs(folder:GetChildren()) do
                    if prop.Name:find("Prop" .. LP.Name) then
                        n = n + 1
                    end
                end
            end
        end)
        return n
    end

    -- mode: "kill" | "bring"  — matches your paste placement
    local function spawnPropsBatch(amount, mode, stillOn)
        amount = math.clamp(math.floor(tonumber(amount) or 15), 1, 50)
        mode = mode or "bring"

        local RE = RS:WaitForChild("RE", 8)
        if not RE then return false, "RE missing" end
        local ToolRemote = RE:WaitForChild("1Too1l", 5)
        local ClearRemote = RE:WaitForChild("1Clea1rTool1s", 5)
        if not ToolRemote or not ClearRemote then return false, "remotes missing" end

        local function getPropMaker()
            pcall(function() ToolRemote:InvokeServer("PickingTools", "PropMaker") end)
            task.wait(0.45)
            local char = LP.Character
            local bp = LP:FindFirstChild("Backpack") or LP:WaitForChild("Backpack", 5)
            if not char or not bp then return nil end
            local tool = bp:FindFirstChild("PropMaker") or char:FindFirstChild("PropMaker")
            if not tool then
                -- retry pick
                pcall(function() ToolRemote:InvokeServer("PickingTools", "PropMaker") end)
                task.wait(0.5)
                tool = bp:FindFirstChild("PropMaker") or char:FindFirstChild("PropMaker")
            end
            if tool then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    pcall(function() hum:EquipTool(tool) end)
                    task.wait(0.35)
                end
                return tool
            end
            return nil
        end

        local baseplate = getBaseplate()
        if not baseplate then return false, "Baseplate missing" end

        local placed = 0
        for i = 1, amount do
            if stillOn and not stillOn() then break end

            -- request name + equip every place (more reliable than every 5)
            pcall(function()
                ClearRemote:FireServer("RequestingPropName", "FurnitureBleachers", "Furniture")
            end)
            task.wait(0.25)

            local propMaker = getPropMaker()
            if not propMaker then
                task.wait(0.3)
                propMaker = getPropMaker()
            end
            if not propMaker then
                if showToast then showToast("Admin Abuse", "PropMaker fail at " .. i, "error") end
                break
            end
            local toolEvent = propMaker:FindFirstChild("Tool_PropMake")
            if not toolEvent then
                toolEvent = propMaker:WaitForChild("Tool_PropMake", 3)
            end
            if not toolEvent then break end

            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- spread in a grid so props don't stack into 1-2
                local col = ((i - 1) % 5) - 2
                local row = math.floor((i - 1) / 5)
                local look = hrp.CFrame.LookVector
                local right = hrp.CFrame.RightVector
                local base
                if mode == "kill" then
                    base = hrp.Position + (look * 6) + Vector3.new(0, 8, 0)
                    local pos = base + right * (col * 4) + look * (row * 3)
                    pos = Vector3.new(pos.X, baseplate.Position.Y + (baseplate.Size.Y / 2) + 4, pos.Z)
                    pcall(function() toolEvent:FireServer(baseplate, pos) end)
                else
                    base = hrp.Position + (look * 5) + Vector3.new(0, 1, 0)
                    local pos = base + right * (col * 4) + look * (row * 3)
                    pos = Vector3.new(pos.X, baseplate.Position.Y + (baseplate.Size.Y / 2), pos.Z)
                    pcall(function() toolEvent:FireServer(baseplate, pos) end)
                end
                placed = placed + 1
            end
            task.wait(0.4)
            if Shared.propCount then
                -- soft refresh
            end
        end
        task.wait(0.5)
        return placed > 0, placed
    end

    AdminAbusePage = Instance.new("ScrollingFrame", Content)
