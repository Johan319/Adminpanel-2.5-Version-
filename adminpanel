-- dark overlay with a padlock, blocks the page underneath
function Shared.makeLock(page, title, sub, check)
    local ov = Instance.new("Frame", page)
    ov.Name = "LockOverlay"
    ov.BackgroundColor3 = Color3.new(0, 0, 0)
    ov.BackgroundTransparency = 0.08
    ov.BorderSizePixel = 0
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.Active = true
    ov.ZIndex = 100
    corner(ov, 12)

    local shackle = Instance.new("Frame", ov)
    shackle.BackgroundTransparency = 1
    shackle.AnchorPoint = Vector2.new(0.5, 0)
    shackle.Position = UDim2.new(0.5, 0, 0.5, -48)
    shackle.Size = UDim2.new(0, 18, 0, 24)
    shackle.ZIndex = 101
    corner(shackle, 9)
    stroke(shackle, Accent, 3, 0)

    local body = Instance.new("Frame", ov)
    body.BackgroundColor3 = Accent
    body.BorderSizePixel = 0
    body.AnchorPoint = Vector2.new(0.5, 0)
    body.Position = UDim2.new(0.5, 0, 0.5, -30)
    body.Size = UDim2.new(0, 30, 0, 24)
    body.ZIndex = 102
    corner(body, 5)

    local keyhole = Instance.new("Frame", body)
    keyhole.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    keyhole.BorderSizePixel = 0
    keyhole.AnchorPoint = Vector2.new(0.5, 0.5)
    keyhole.Position = UDim2.new(0.5, 0, 0.5, 0)
    keyhole.Size = UDim2.new(0, 5, 0, 8)
    keyhole.ZIndex = 103
    corner(keyhole, 2)

    local t = lbl(ov, title, 15, TextHi, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
    t.Position = UDim2.new(0, 0, 0.5, 4)
    t.Size = UDim2.new(1, 0, 0, 20)
    t.ZIndex = 101

    local s = lbl(ov, sub, 10, TextMid, Enum.Font.Gotham, Enum.TextXAlignment.Center)
    s.Position = UDim2.new(0, 0, 0.5, 26)
    s.Size = UDim2.new(1, 0, 0, 14)
    s.ZIndex = 101

    -- floating animation on the lock icon + text
    task.spawn(function()
        local t0 = 0
        while ov.Parent do
            t0 += RunService.Heartbeat:Wait()
            if ov.Visible then
                local wave = math.sin(t0 * 2.0) * 4
                shackle.Position = UDim2.new(0.5, 0, 0.5, -48 + wave)
                body.Position = UDim2.new(0.5, 0, 0.5, -30 + wave)
                t.Position = UDim2.new(0, 0, 0.5, 4 + wave * 0.3)
                s.Position = UDim2.new(0, 0, 0.5, 26 + wave * 0.3)
            end
        end
    end)

    check = check or function() return true end
    ov.Visible = check()
    table.insert(Shared.locks, { overlay = ov, check = check })
    return ov
end

-- ===================== VIEW (spectate) + ESP (shared by Players tab and commands) =====================
function Shared.ascii(s)
    return (tostring(s or ""):gsub("[^ -~]", "?"))
end

Shared.view = { target = nil, conns = {}, listeners = {} }

function Shared.viewNotify()
    for f in pairs(Shared.view.listeners) do pcall(f, Shared.view.target) end
end

function Shared.viewStop()
    local v = Shared.view
    for _, c in ipairs(v.conns) do pcall(function() c:Disconnect() end) end
    v.conns = {}
    local was = v.target
    v.target = nil
    local cam = workspace.CurrentCamera
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if cam and hum then
        cam.CameraSubject = hum
        cam.CameraType = Enum.CameraType.Custom
    end
    if was then Shared.viewNotify() end
end

-- watches a player through their Humanoid; follows them when they respawn and stops if they leave
function Shared.viewStart(plr)
    if not plr or plr == LP then
        Shared.viewStop()
        return
    end
    local v = Shared.view
    for _, c in ipairs(v.conns) do pcall(function() c:Disconnect() end) end
    v.conns = {}
    v.target = plr

    local function follow()
        local char = plr.Character
        local hum = char and (char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5))
        local cam = workspace.CurrentCamera
        if hum and cam and v.target == plr then
            cam.CameraSubject = hum
            cam.CameraType = Enum.CameraType.Custom
        end
    end
    task.spawn(follow)

    table.insert(v.conns, plr.CharacterAdded:Connect(function()
        task.spawn(follow)
    end))
    table.insert(v.conns, Players.PlayerRemoving:Connect(function(leaving)
        if leaving == plr then Shared.viewStop() end
    end))
    table.insert(v.conns, UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.KeyCode == Enum.KeyCode.Space or inp.KeyCode == Enum.KeyCode.Escape then
            Shared.viewStop()
        end
    end))
    Shared.viewNotify()
end

