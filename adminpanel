-- ===== SCRIPT BAN LIST (only affects people who run this panel) =====
Shared.scriptBans = {}
-- Put UserIds here so EVERYONE who runs this same script file is banned (kicked on execute).
-- Local file bans only exist on your PC; this table is inside the script for all users.
Shared.HARD_SCRIPT_BANS = {
    -- [123456789] = "reason",
}
local SCRIPT_BAN_FILE = "AdminPanel_script_bans.json"
local function loadScriptBans()
    Shared.scriptBans = {}
    if readfile and isfile then
        pcall(function()
            if isfile(SCRIPT_BAN_FILE) then
                local data = HttpService:JSONDecode(readfile(SCRIPT_BAN_FILE))
                if type(data) == "table" and type(data.bans) == "table" then
                    for _, v in ipairs(data.bans) do
                        if type(v) == "table" and tonumber(v.id) then
                            Shared.scriptBans[tostring(v.id)] = {
                                id = tonumber(v.id),
                                name = tostring(v.name or ""),
                                reason = tostring(v.reason or "Script banned"),
                                at = tonumber(v.at) or 0,
                            }
                        end
                    end
                end
            end
        end)
    end
end
local function saveScriptBans()
    if not writefile then return false end
    local bans = {}
    for _, v in pairs(Shared.scriptBans) do
        bans[#bans + 1] = v
    end
    return pcall(function()
        writefile(SCRIPT_BAN_FILE, HttpService:JSONEncode({ bans = bans }))
    end)
end
loadScriptBans()
for id, reason in pairs(Shared.HARD_SCRIPT_BANS or {}) do
    local uid = tonumber(id)
    if uid then
        Shared.scriptBans[tostring(uid)] = Shared.scriptBans[tostring(uid)] or {
            id = uid,
            name = "",
            reason = tostring(reason or "Script banned"),
            at = 0,
        }
    end
end
do
    local entry = Shared.scriptBans[tostring(LP.UserId)]
    if entry then
        pcall(function()
            LP:Kick("Script banned: " .. tostring(entry.reason or "You are banned from this panel"))
        end)
        return
    end
end
Shared.loadScriptBans = loadScriptBans
Shared.saveScriptBans = saveScriptBans

-- AI Premium Tokens (start 100.00). Chat costs a random amount from 0.01 up to 10.
-- When empty, tokens auto-refill to 100.00 after a random 2–4 hours.
Shared.tokens = 100.00
Shared.tokenEmptyAt = nil
Shared.tokenRegenHours = nil
Shared.tokenListeners = {}
Shared.tokenEmptyListeners = {}
function Shared.setTokens(n)
    local prev = Shared.tokens
    Shared.tokens = math.max(0, math.floor((tonumber(n) or 0) * 100 + 0.5) / 100)
    if Shared.tokens > 0 then
        Shared.tokenEmptyAt = nil
        Shared.tokenRegenHours = nil
    elseif prev > 0 and Shared.tokens <= 0 then
        Shared.tokenEmptyAt = os.clock()
        Shared.tokenRegenHours = 2 + math.random() * 2 -- 2 to 4 hours
        for _, f in ipairs(Shared.tokenEmptyListeners) do pcall(f) end
    end
    for _, f in ipairs(Shared.tokenListeners) do pcall(f, Shared.tokens) end
end
function Shared.addTokens(n)
    Shared.setTokens(Shared.tokens + (tonumber(n) or 0))
end
function Shared.spendTokens()
    -- cost: 0.01, or whole numbers 1–10 (mixed feel)
    local roll = math.random()
    local cost
    if roll < 0.25 then
        cost = math.floor((0.01 + math.random() * 0.99) * 100 + 0.5) / 100 -- 0.01 .. 1.00
    else
        cost = math.random(1, 10) -- 1 .. 10
    end
    if Shared.tokens < cost then return false, cost end
    Shared.setTokens(Shared.tokens - cost)
    return true, cost
end
-- background regen when empty
task.spawn(function()
    while true do
        task.wait(30)
        if Shared.tokens <= 0 and Shared.tokenEmptyAt and Shared.tokenRegenHours then
            local elapsedH = (os.clock() - Shared.tokenEmptyAt) / 3600
            if elapsedH >= Shared.tokenRegenHours then
                Shared.setTokens(100.00)
                pcall(function()
                    if showToast then showToast("Tokens refilled", "Back to 100.00", "success") end
                end)
            end
        end
    end
end)

