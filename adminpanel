    local nameCache = {}
    local rankTimers = {}
    local TAG_TEXT = { auto = "(auto)", rank = "(rank)", permrank = "(permrank)", temprank = "(temprank)" }
    local TAG_NOTE = {
        auto = "automatic", rank = "until you leave", permrank = "saved", temprank = "",
    }
    local TAG_COLOR = {
        auto = Green, rank = Accent,
        permrank = Color3.fromRGB(255, 200, 70), temprank = Color3.fromRGB(255, 150, 60),
    }
    local TAG_ORDER = { auto = 1, permrank = 2, rank = 3, temprank = 4 }

    local function collectRanks()
        local entries = {}
        local function add(uid, name, rank, premium, tag, expires)
            entries[#entries + 1] = {
                uid = uid, name = name, rank = rank, premium = premium, tag = tag, expires = expires,
            }
        end
        -- (auto): the rank you get from DEFAULT_RANK / RANK_IDS at the top of the script
        add(LP.UserId, LP.Name, Shared.baseRank, Shared.basePremium, "auto")
        for rk, rankLabel in ipairs(Shared.RANK_NAMES) do
            local list = Shared.RANK_IDS[rankLabel]
            if list then
                for _, id in ipairs(list) do
                    if id ~= LP.UserId then add(id, nil, rk, false, "auto") end
                end
            end
        end
        for _, id in ipairs(Shared.PREMIUM_IDS) do
            if id ~= LP.UserId then add(id, nil, nil, true, "auto") end
        end
        for key, g in pairs(grants.session) do add(tonumber(key), g.name, g.rank, g.premium, "rank") end
        for key, g in pairs(grants.perm) do add(tonumber(key), g.name, g.rank, g.premium, "permrank") end
        for key, g in pairs(grants.temp) do add(tonumber(key), g.name, g.rank, g.premium, "temprank", g.expires) end
        return entries
    end

    local function renderRanks()
        for _, c in ipairs(RList:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        rankTimers = {}

        local order, pops = 0, 0
        local function nextOrder()
            order += 1
            return order
        end

        local function header(text)
            local h = lbl(RList, "------" .. text .. "------", 11, Accent, Enum.Font.Code,
                Enum.TextXAlignment.Center)
            h.LayoutOrder = nextOrder()
            h.Size = UDim2.new(1, 0, 0, 24)
            h.ZIndex = 43
        end

        local function addRow(e)
            pops += 1
            local idText = string.format("%d", e.uid or 0)
            local row = Instance.new("Frame", RList)
            row.LayoutOrder = nextOrder()
            row.BackgroundColor3 = Panel
            row.BorderSizePixel = 0
            row.Size = UDim2.new(1, 0, 0, 54)
            row.ZIndex = 43
            corner(row, 10)
            stroke(row, StrokeCol, 1, 0.4)

            local sc = Instance.new("UIScale", row)
            sc.Scale = 0.92
            task.delay(math.min(pops * 0.05, 0.5), function()
                if sc.Parent then
                    TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                        { Scale = 1 }):Play()
                end
            end)

            -- the player's face
            local av = Instance.new("ImageLabel", row)
            av.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            av.BorderSizePixel = 0
            av.Position = UDim2.new(0, 10, 0.5, -20)
            av.Size = UDim2.new(0, 40, 0, 40)
            av.Image = "rbxthumb://type=AvatarHeadShot&id=" .. idText .. "&w=150&h=150"
            av.ZIndex = 44
            corner(av, 0).CornerRadius = UDim.new(0.5, 0)
            stroke(av, TAG_COLOR[e.tag], 1.5, 0.2)

            local pl = Players:GetPlayerByUserId(e.uid or 0)
            local name = e.name or (pl and pl.Name) or nameCache[e.uid]
            local nameL = lbl(row, ascii(name or ("ID " .. idText)), 12, TextHi)
            nameL.Position = UDim2.new(0, 60, 0, 9)
            nameL.Size = UDim2.new(1, -170, 0, 16)
            nameL.ZIndex = 44
            if not name then
                task.spawn(function()
                    local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(e.uid) end)
                    if ok and n then
                        nameCache[e.uid] = n
                        if nameL.Parent then nameL.Text = ascii(n) end
                    end
                end)
            end

            local parts = {}
            if e.rank then parts[#parts + 1] = Shared.RANK_NAMES[e.rank] end
            if e.premium then parts[#parts + 1] = "Premium" end
            local subL = lbl(row, table.concat(parts, "  |  "), 10, TextMid, Enum.Font.Gotham)
            subL.Position = UDim2.new(0, 60, 0, 29)
            subL.Size = UDim2.new(1, -170, 0, 14)
            subL.ZIndex = 44

            local tagL = lbl(row, TAG_TEXT[e.tag], 10, TAG_COLOR[e.tag], Enum.Font.GothamBold,
                Enum.TextXAlignment.Right)
            tagL.AnchorPoint = Vector2.new(1, 0)
            tagL.Position = UDim2.new(1, -12, 0, 10)
            tagL.Size = UDim2.new(0, 100, 0, 14)
            tagL.ZIndex = 44

            local noteL = lbl(row, TAG_NOTE[e.tag], 9, TextLo, Enum.Font.Gotham, Enum.TextXAlignment.Right)
            noteL.AnchorPoint = Vector2.new(1, 0)
            noteL.Position = UDim2.new(1, -12, 0, 29)
            noteL.Size = UDim2.new(0, 100, 0, 14)
            noteL.ZIndex = 44
            if e.expires then
                rankTimers[#rankTimers + 1] = { label = noteL, expires = e.expires }
                noteL.Text = fmtDuration(math.max(0, e.expires - os.clock())) .. " left"
            end
        end

        local groups = {}
        for _, e in ipairs(collectRanks()) do
            local key = e.rank or 0
            groups[key] = groups[key] or {}
            table.insert(groups[key], e)
        end
        for key = #Shared.RANK_NAMES, 0, -1 do
            local list = groups[key]
            if list then
                table.sort(list, function(a, b)
                    if a.tag ~= b.tag then return TAG_ORDER[a.tag] < TAG_ORDER[b.tag] end
                    return tostring(a.name or a.uid) < tostring(b.name or b.uid)
                end)
                header(key == 0 and "Premium" or Shared.RANK_NAMES[key])
                for _, e in ipairs(list) do addRow(e) end
            end
        end
    end

    refreshRanks = function()
        if RW.isOpen() then renderRanks() end
    end

    updateRankTimers = function()
        if not RW.isOpen() then return end
        local now = os.clock()
        for _, t in ipairs(rankTimers) do
            if t.label.Parent then
                t.label.Text = fmtDuration(math.max(0, t.expires - now)) .. " left"
            end
        end
    end

    openRanks = function()
        renderRanks()
        RW.open()
    end

    -- ---------- chat commands ----------
    local lastMsg, lastAt = "", 0
    local function handleChat(msg)
        if type(msg) ~= "string" then return end
        local p = state.prefix
        if msg:sub(1, #p) ~= p then return end
        if msg == lastMsg and os.clock() - lastAt < 0.6 then return end   -- both chat systems fired
        local body = msg:sub(#p + 1)
        local name = (body:match("^%s*(%S+)") or ""):lower()
        local entry = LOOKUP[name]
        if not entry then return end                    -- normal chat, ignore quietly
        if not state.chatOn and entry.name ~= "cmds" then return end
        lastMsg, lastAt = msg, os.clock()
        logLine("[chat] " .. msg, "input")
        local status, out = runCommand(msg)
        if out then
            logLine(out, status == true and "ok" or "err")
            showToast("Command", ascii(out), status == true and "success" or "error")
        end
    end

    conns[#conns + 1] = LP.Chatted:Connect(handleChat)
    pcall(function()
        local TextChatService = game:GetService("TextChatService")
        conns[#conns + 1] = TextChatService.MessageReceived:Connect(function(message)
            local src = message.TextSource
            if src and src.UserId == LP.UserId then handleChat(message.Text) end
        end)
    end)

    -- keep walk speed / jump power after respawning
    conns[#conns + 1] = LP.CharacterAdded:Connect(function(ch)
        local h = ch:WaitForChild("Humanoid", 10)
        if not h then return end
        task.wait(0.3)
        if state.ws then h.WalkSpeed = state.ws end
        if state.jp then
            h.UseJumpPower = true
            h.JumpPower = state.jp
        end
    end)

    conns[#conns + 1] = gui.Destroying:Connect(function()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        stopNoclip()
        stopXray()
        stopSpin()
        Shared.viewStop()
        Shared.espClear()
        Shared.vanishClear()
    end)

    -- ---------- startup ----------
    if loadSettings() then
        updateSub()
        for _, f in ipairs(prefixListeners) do pcall(f) end
    end
    syncMyGrants()      -- saved ranks that belong to you apply right away

    task.spawn(function()
        while gui.Parent do
            task.wait(1)
            expireTemps()
            if updateRankTimers then updateRankTimers() end
        end
    end)
    logLine("Admin Panel (2.5) console  -  rank: " .. rankName(), "info")
    logLine('Type a command like "walkspeed 50", or "cmds" for the full list.', "info")
    logLine("Chat commands use the prefix " .. state.prefix
        .. " (other players can see chat messages). Console commands stay private.", "info")
    if state.autosave then logLine("Loaded your saved prefix.", "ok") end
    do
        local savedCount = 0
        for _ in pairs(grants.perm) do savedCount += 1 end
        if savedCount > 0 then logLine("Loaded " .. savedCount .. " saved rank(s).", "ok") end
    end

    Shared.makeLock(Page, "Mods only", "Ask a Mod or higher to unlock this tab.",
        function() return Shared.rank < 2 end)

    return Page
end)()

