-- Descriptions can hold emoji / weird unicode / huge text that can freeze a
-- label on mobile, so keep only short plain text.
local function cleanText(s, maxLen)
    if type(s) ~= "string" or s == "" then return "(no description)" end
    s = s:gsub("%c+", " ")
    s = s:gsub("[^ -~]", "")
    s = s:gsub("%s+", " ")
    s = s:match("^%s*(.-)%s*$") or ""
    if s == "" then return "(no description)" end
    if #s > maxLen then s = s:sub(1, maxLen - 3) .. "..." end
    return s
end

local function countOf(r)
    if type(r) == "table" and r.count ~= nil then return tostring(r.count) end
    return "N/A"
end

