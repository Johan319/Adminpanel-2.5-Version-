    -- reveals the reply letter by letter (tap Skip to show it all at once)
    local function typewrite(label)
        local full = label.Text
        local total = utf8.len(full) or #full
        typingNow, skipTyping = true, false
        local follow = nearBottom()
        label.MaxVisibleGraphemes = 0
        local dur = math.clamp(total / 160, 0.6, 5)
        local t0 = os.clock()
        while label.Parent and not skipTyping do
            local a = (os.clock() - t0) / dur
            if a >= 1 then break end
            label.MaxVisibleGraphemes = math.floor(total * a)
            if follow then snapBottom() end
            RunService.Heartbeat:Wait()
        end
        label.MaxVisibleGraphemes = -1
        typingNow, skipTyping = false, false
        if follow then scrollBottom() end
    end

