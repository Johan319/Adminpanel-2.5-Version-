local function showToast(title, message, kind, duration)
    kind = kind or "info"
    duration = duration or 2

    local kindColor = Accent
    if kind == "success" then kindColor = Green
    elseif kind == "error" then kindColor = Red
    elseif kind == "loading" then kindColor = Yellow end

    local toast = Instance.new("Frame", ToastHolder)
    toast.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
    toast.BorderSizePixel = 0
    toast.Size = UDim2.new(1, 0, 0, 56)
    toast.ZIndex = 501
    toast.BackgroundTransparency = 1
    corner(toast, 12)

    local ts = stroke(toast, kindColor, 1.4, 0.3)

    local bar = Instance.new("Frame", toast)
    bar.BackgroundColor3 = kindColor
    bar.BorderSizePixel = 0
    bar.Position = UDim2.new(0, 0, 0, 8)
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.ZIndex = 502
    corner(bar, 3)

    local iconBox = Instance.new("Frame", toast)
    iconBox.BackgroundColor3 = kindColor
    iconBox.BackgroundTransparency = 0.85
    iconBox.BorderSizePixel = 0
    iconBox.AnchorPoint = Vector2.new(0, 0.5)
    iconBox.Position = UDim2.new(0, 14, 0.5, 0)
    iconBox.Size = UDim2.new(0, 32, 0, 32)
    iconBox.ZIndex = 502
    corner(iconBox, 16)
    stroke(iconBox, kindColor, 1.4, 0.2)

    local spin = Instance.new("Frame", iconBox)
    spin.BackgroundTransparency = 1
    spin.AnchorPoint = Vector2.new(0.5, 0.5)
    spin.Position = UDim2.new(0.5, 0, 0.5, 0)
    spin.Size = UDim2.new(0, 18, 0, 18)
    spin.ZIndex = 503

    local spinner = Instance.new("Frame", spin)
    spinner.BackgroundTransparency = 1
    spinner.Size = UDim2.new(1, 0, 1, 0)
    spinner.ZIndex = 504
    stroke(spinner, kindColor, 2, 0.3)
    spinner.Rotation = 0

    if kind ~= "loading" then
        spinner.Visible = false
        local dot = Instance.new("Frame", spin)
        dot.BackgroundColor3 = kindColor
        dot.BorderSizePixel = 0
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Position = UDim2.new(0.5, 0, 0.5, 0)
        dot.Size = UDim2.new(0, 8, 0, 8)
        dot.ZIndex = 504
        corner(dot, 4)
    else
        task.spawn(function()
            while spinner.Parent do
                spinner.Rotation = (spinner.Rotation + 6) % 360
                RunService.Heartbeat:Wait()
            end
        end)
    end

    local tTitle = lbl(toast, title, 12, TextHi)
    tTitle.Position = UDim2.new(0, 58, 0, 12)
    tTitle.Size = UDim2.new(1, -72, 0, 16)
    tTitle.ZIndex = 503

    local tMsg = lbl(toast, message or "", 10, TextMid, Enum.Font.Gotham)
    tMsg.Position = UDim2.new(0, 58, 0, 30)
    tMsg.Size = UDim2.new(1, -72, 0, 14)
    tMsg.ZIndex = 503

    toast.Position = UDim2.new(0, 0, 0, -60)
    TweenService:Create(toast, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 }):Play()

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local tw = TweenService:Create(toast,
            TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Position = UDim2.new(0, 0, 0, -60), BackgroundTransparency = 1 })
        TweenService:Create(ts, TweenInfo.new(0.28), { Transparency = 1 }):Play()
        TweenService:Create(tTitle, TweenInfo.new(0.28), { TextTransparency = 1 }):Play()
        TweenService:Create(tMsg, TweenInfo.new(0.28), { TextTransparency = 1 }):Play()
        TweenService:Create(bar, TweenInfo.new(0.28), { BackgroundTransparency = 1 }):Play()
        tw.Completed:Connect(function()
            if toast.Parent then toast:Destroy() end
        end)
        tw:Play()
    end

    if duration > 0 then
        task.delay(duration, dismiss)
    end

    return {
        frame = toast,
        titleLbl = tTitle,
        msgLbl = tMsg,
        stroke = ts,
        spinner = spinner,
        dismiss = dismiss,
        kind = kind,
    }
end

