    local box = Instance.new("Frame", parent)
    box.BackgroundTransparency = 1
    box.Position = UDim2.new(0, x, 0, y)
    box.Size = UDim2.new(0, 14, 0, 14)
    box.ZIndex = z
    local function part(px, py, sx, sy, rad)
        local f = Instance.new("Frame", box)
        f.BackgroundColor3 = col
        f.BorderSizePixel = 0
        f.Position = UDim2.new(0, px, 0, py)
        f.Size = UDim2.new(0, sx, 0, sy)
        f.ZIndex = z
        corner(f, rad)
    end
    part(0, 6, 3, 8, 1)
    part(4, 5, 10, 9, 2)
    part(6, 0, 3, 7, 2)
    return box
end

