-- ===================== PROTECTIONS =====================
Shared.protections = Shared.protections or {
    states = {},
    conns = {},
    threads = {},
}

local function protSet(key, on)
    Shared.protections.states[key] = on and true or false
end
local function protOn(key)
    return Shared.protections.states[key] == true
end
local function protClear(key)
    local c = Shared.protections.conns[key]
    if type(c) == "table" then
        for _, x in ipairs(c) do pcall(function() x:Disconnect() end) end
    elseif c then
        pcall(function() c:Disconnect() end)
    end
    Shared.protections.conns[key] = nil
    local th = Shared.protections.threads[key]
    if th then pcall(task.cancel, th) end
    Shared.protections.threads[key] = nil
end

function Shared.setProtection(key, on)
    key = tostring(key or ""):lower()
    protClear(key)
    protSet(key, on)
    local LP = Players.LocalPlayer

    if key == "anticollision" then
        if on then
            local function strip(char)
                if not char then return end
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                        pcall(function() p.CanCollide = false end)
                    end
                end
            end
            local list = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character then strip(plr.Character) end
                list[#list+1] = plr.CharacterAdded:Connect(function(c) if plr ~= LP then strip(c) end end)
            end
            list[#list+1] = Players.PlayerAdded:Connect(function(plr)
                list[#list+1] = plr.CharacterAdded:Connect(function(c) if plr ~= LP then strip(c) end end)
            end)
            Shared.protections.conns[key] = list
        end
    elseif key == "antisit" or key == "antisitv2" then
        if on then
            local function apply(h)
                if h then pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end) end
            end
            local char = LP.Character
            apply(char and char:FindFirstChildOfClass("Humanoid"))
            local c = LP.CharacterAdded:Connect(function(ch)
                apply(ch:WaitForChild("Humanoid", 5))
            end)
            Shared.protections.conns[key] = c
        else
            local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end) end
        end
    elseif key == "anticrash" then
        if on then
            pcall(function()
                local ps = LP:FindFirstChild("PlayerScripts")
                local b = ps and ps:FindFirstChild("BulletVisualizerScript")
                if b then b.Disabled = true end
            end)
        else
            pcall(function()
                local ps = LP:FindFirstChild("PlayerScripts")
                local b = ps and ps:FindFirstChild("BulletVisualizerScript")
                if b then b.Disabled = false end
            end)
        end
    elseif key == "antivoid" then
        if on then
            pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
        else
            pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
        end
    elseif key == "antilagserver" then
        if on then
            local th = task.spawn(function()
