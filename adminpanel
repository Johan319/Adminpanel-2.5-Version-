        local nameL = lbl(row, name, 12, TextHi, Enum.Font.Gotham)
        nameL.Position = UDim2.new(0, 14, 0, 0)
        nameL.Size = UDim2.new(1, -80, 1, 0)
        nameL.ZIndex = 5
        nameL.TextYAlignment = Enum.TextYAlignment.Center

        local tog = Instance.new("TextButton", row)
        tog.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
        tog.BorderSizePixel = 0
        tog.AnchorPoint = Vector2.new(1, 0.5)
        tog.Position = UDim2.new(1, -12, 0.5, 0)
        tog.Size = UDim2.new(0, 52, 0, 28)
        tog.Text = ""
        tog.AutoButtonColor = false
        tog.ZIndex = 5
        corner(tog, 14)
        stroke(tog, Color3.fromRGB(50, 50, 56), 1, 0.5)
        local knob = Instance.new("Frame", tog)
        knob.BackgroundColor3 = Color3.fromRGB(210, 210, 215)
        knob.BorderSizePixel = 0
        knob.Size = UDim2.new(0, 22, 0, 22)
        knob.Position = UDim2.new(0, 3, 0.5, -11)
        knob.ZIndex = 6
        corner(knob, 11)

        local function setVisual(on)
            TweenService:Create(tog, TweenInfo.new(0.15), {
                BackgroundColor3 = on and Color3.fromRGB(120, 40, 40) or Color3.fromRGB(28, 28, 32)
            }):Play()
            TweenService:Create(knob, TweenInfo.new(0.15), {
                Position = on and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
                BackgroundColor3 = on and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(210, 210, 215)
            }):Play()
        end

        tog.MouseButton1Click:Connect(function()
            if Shared.rank < 6 then
                if showToast then showToast("Admin Abuse", "Owner only", "error") end
                return
            end
            local n = tonumber(amountBox.Text) or propAmount or 15
            propAmount = math.clamp(math.floor(n), 1, 50)
            amountBox.Text = tostring(propAmount)

            abuseState[key] = not abuseState[key]
            local on = abuseState[key]
            setVisual(on)
            if abuseThreads[key] then
                pcall(task.cancel, abuseThreads[key])
                abuseThreads[key] = nil
            end

            if on then
                local other = (key == "bringAll") and "killAll" or "bringAll"
                abuseState[other] = false
                if showToast then
                    showToast("Admin Abuse", name .. " ON  •  " .. propAmount .. " props", "success")
                end
                abuseThreads[key] = task.spawn(function()
                    local function stillOn() return abuseState[key] == true end
                    Shared._propKeepAlive = true

                    -- Place exactly the number in the box (spread grid)
                    local okPlace, placedN = spawnPropsBatch(propAmount, mode, stillOn)
                    refreshPropCount()
                    if showToast then
                        showToast("Admin Abuse", "Placed ~" .. tostring(placedN or propAmount) .. " props", "info")
                    end
                    task.wait(0.6)

                    -- Divide props among players (15 props → split across targets)
                    if stillOn() then
                        local targets = {}
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LP then targets[#targets + 1] = plr end
                        end
                        local allProps = {}
                        if Shared._getMyProps then
                            allProps = Shared._getMyProps()
                        end
                        local nProps = #allProps
                        local nT = math.max(1, #targets)
                        -- each player gets a slice of the prop list
                        local per = math.max(1, math.floor(nProps / nT))
                        if nProps == 0 then per = 0 end

                        for ti, plr in ipairs(targets) do
                            if not stillOn() then break end
                            local slice = {}
                            if nProps > 0 then
                                local startI = (ti - 1) * per + 1
                                local endI = (ti == nT) and nProps or math.min(nProps, ti * per)
                                for pi = startI, endI do
                                    if allProps[pi] then slice[#slice + 1] = allProps[pi] end
                                end
                                -- if leftover uneven, last players already got remainder via endI
                            end
                            -- use only this player's props for bring/kill
                            Shared._propSlice = slice
                            Shared._propKeepAlive = true
                            if mode == "kill" and Shared.killPlayer then
                                pcall(function() Shared.killPlayer(plr) end)
                            elseif mode == "bring" and Shared.bringPlayer then
                                pcall(function() Shared.bringPlayer(plr) end)
                            end
                            task.wait(1.8)
                            Shared._propSlice = nil
                            refreshPropCount()
                        end
                    end

                    -- auto clear props when mass queue finishes (stops corruption)
                    Shared._propKeepAlive = false
                    Shared._propSlice = nil
                    if Shared.clearMyProps then
                        Shared.clearMyProps()
                    else
                        clearAllProps()
                    end
                    abuseState[key] = false
                    setVisual(false)
                    refreshPropCount()
                    if showToast then showToast("Admin Abuse", name .. " done  •  props cleared", "info") end
                end)
            else
                Shared._propKeepAlive = false
                clearAllProps()
                refreshPropCount()
                if showToast then showToast("Admin Abuse", name .. " OFF  •  ClearAllProps", "info") end
            end
        end)
        setVisual(false)
    end

    makeAbuseToggle(5, "Bring All Players + Props", "bringAll", "bring")
    makeAbuseToggle(6, "Kill All Players + Props", "killAll", "kill")
    do
        local on, conn, gen = false, nil, 0
        local tools = {"Phone","Tablet","PropMaker","Boombox","Taser","Bomb"}
        local b = Instance.new("TextButton", AdminAbusePage)
        b.LayoutOrder = 7
        b.Size = UDim2.new(1, 0, 0, 40)
        b.BackgroundColor3 = Panel
        b.Text = "Fe Lag Server: OFF"
        b.TextColor3 = TextHi
        b.Font = Enum.Font.Gotham
        b.TextSize = 12
        b.ZIndex = 4
        corner(b, 10)
        b.MouseButton1Click:Connect(function()
            if on then
                on, gen = false, gen + 1
                if conn then pcall(function() conn:Disconnect() end) conn = nil end
                b.Text = "Fe Lag Server: OFF"
                for _, bag in ipairs({LP:FindFirstChildOfClass("Backpack"), LP.Character}) do
                    if bag then
                        for _, tool in ipairs(bag:GetChildren()) do
                            if tool:IsA("Tool") then
                                for _, n in ipairs(tools) do
                                    if tool.Name == n then pcall(function() tool:Destroy() end) break end
                                end
                            end
                        end
                    end
                end
                return
            end
            on, gen = true, gen + 1
            local myGen, rt = gen, nil
            b.Text = "Fe Lag Server: ON"
            pcall(function()
                local RE = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
                rt = RE and RE:FindFirstChild("1Too1l")
            end)
            if conn then pcall(function() conn:Disconnect() end) conn = nil end
            conn = RunService.Heartbeat:Connect(function()
                if (not on) or myGen ~= gen or not rt then return end
                for i = 1, #tools do
                    if (not on) or myGen ~= gen then return end
                    local n = tools[i]
                    task.spawn(function()
                        if on and myGen == gen and rt then pcall(function() rt:InvokeServer("PickingTools", n) end) end
                    end)
                end
            end)
        end)
    end

    local warnL = lbl(AdminAbusePage, "ON = props + players. OFF = clear. FE OFF fully stops spam.", 10, TextLo, Enum.Font.Gotham)
    warnL.LayoutOrder = 8
    warnL.Size = UDim2.new(1, 0, 0, 28)
    warnL.TextWrapped = true
    refreshPropCount()
end


