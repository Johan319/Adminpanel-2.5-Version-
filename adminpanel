				end
			end)

			local nm = label(row, name, 12, TEXT, Enum.Font.GothamBold)
			nm.Position = UDim2.new(0, 12, 0, 8)
			nm.Size = UDim2.new(1, -100, 0, 16)
			nm.ZIndex = 24
			local sub = label(row, name == currentBuilderServer and "ACTIVE  •  click to open" or "Builder workspace", 9, name == currentBuilderServer and ACCENT or SUB, Enum.Font.Gotham)
			sub.Position = UDim2.new(0, 12, 0, 27)
			sub.Size = UDim2.new(1, -100, 0, 12)
			sub.ZIndex = 24

			local del = button(row, "Del", PANEL2, RED)
			del.AnchorPoint = Vector2.new(1, 0.5)
			del.Position = UDim2.new(1, -8, 0.5, 0)
			del.Size = UDim2.fromOffset(40, 28)
			del.TextSize = 10
			del.ZIndex = 25
			if name == "Main Server" then
				del.TextTransparency = 0.5
				del.Active = false
			else
				del.MouseButton1Click:Connect(function()
					local ok, err = deleteBuilderServer(name)
					if ok then
						serverStatus.Text = "Deleted: " .. name
						renderServerList()
						if showToast then showToast("Servers", "Deleted " .. name, "success") end
					else
						serverStatus.Text = tostring(err or "Could not delete")
					end
				end)
			end

			local rename = button(row, "Rename", PANEL2, TEXT)
			rename.AnchorPoint = Vector2.new(1, 0.5)
			rename.Position = UDim2.new(1, -52, 0.5, 0)
			rename.Size = UDim2.fromOffset(58, 28)
			rename.TextSize = 10
			rename.ZIndex = 25
			rename.MouseButton1Click:Connect(function()
				renameTarget = name
				serverNameInput.Text = name
				serverAction.Text = "Rename"
				serverStatus.Text = "Renaming: " .. name
				serverCancel.Visible = true
			end)
		end
	end

	local serverWin, serverBody = makeWindow("Servers", "Builder Servers", 360, 360, UDim2.new(0.5, -180, 0.5, -180))
	serverWin.ZIndex = 48
	serverNameBox, serverNameInput = textBox(serverBody, "Server name")
	serverNameBox.Position = UDim2.new(0, 8, 0, 8)
	serverNameBox.Size = UDim2.new(1, -116, 0, 30)
	serverAction = button(serverBody, "Create server", ACCENT, Color3.fromRGB(0, 20, 30))
	serverAction.AnchorPoint = Vector2.new(1, 0)
	serverAction.Position = UDim2.new(1, -8, 0, 8)
	serverAction.Size = UDim2.fromOffset(100, 30)
	serverAction.TextSize = 10
	local serverCancel = button(serverBody, "Cancel", PANEL2, TEXT)
	serverCancel.AnchorPoint = Vector2.new(1, 0)
	serverCancel.Position = UDim2.new(1, -8, 0, 44)
	serverCancel.Size = UDim2.fromOffset(70, 24)
	serverCancel.TextSize = 9
	serverCancel.Visible = false
	serverStatus = label(serverBody, "", 9, SUB, Enum.Font.Gotham)
	serverStatus.Position = UDim2.new(0, 8, 0, 47)
	serverStatus.Size = UDim2.new(1, -88, 0, 18)
	serverStatus.TextTruncate = Enum.TextTruncate.AtEnd
	serverList = scroller(serverBody)
	serverList.Position = UDim2.new(0, 8, 0, 72)
	serverList.Size = UDim2.new(1, -16, 1, -80)
	serverLayout = Instance.new("UIListLayout")
	serverLayout.Padding = UDim.new(0, 6)
	serverLayout.SortOrder = Enum.SortOrder.LayoutOrder
	serverLayout.Parent = serverList
	bindScrollCanvas(serverList, serverLayout, 10)

	refreshServers = function()
		renderServerList()
		if updateServerPill then updateServerPill(currentBuilderServer) end
	end

	local function closeRenameMode()
		renameTarget = nil
		serverNameInput.Text = ""
		serverAction.Text = "Create server"
		serverCancel.Visible = false
		serverStatus.Text = ""
	end

	serverCancel.MouseButton1Click:Connect(closeRenameMode)
	serverAction.MouseButton1Click:Connect(function()
		local name = serverNameInput.Text
		local ok, msg
		if renameTarget then
			ok, msg = renameBuilderServer(renameTarget, name)
			if ok then serverStatus.Text = "Renamed to: " .. cleanServerName(name) else serverStatus.Text = msg end
		else
			ok, msg = createBuilderServer(name)
			if ok then serverStatus.Text = "Created: " .. cleanServerName(name) else serverStatus.Text = msg end
		end
		if ok then closeRenameMode(); renderServerList() else serverStatus.TextColor3 = RED end
		serverStatus.TextColor3 = SUB
	end)

	openServerManager = function()
		setMenu(false)
		if refreshServers then refreshServers() end
		animateWindowOpen(serverWin)
	end
	windows.Servers = serverWin
	loadServerIndex()
	renderServerList()
end

