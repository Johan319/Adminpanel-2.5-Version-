end

-- ===================== EXECUTOR HTTP HELPER =====================
local function httpGet(url)
    local req = (syn and syn.request)
        or (http and http.request)
        or http_request
        or request
        or (fluxus and fluxus.request)
    if req then
        local ok, res = pcall(function()
            return req({ Url = url, Method = "GET" })
        end)
        if ok and type(res) == "table" and type(res.Body) == "string" then
            local code = res.StatusCode or 200
            if code >= 200 and code < 300 then
                return res.Body
            end
        end
    end
    -- HttpService:GetAsync only works on the server, so use the executor's HttpGet
    local ok2, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok2 and type(body) == "string" then return body end
    return nil
end

local function httpGetJSON(url)
    local body = httpGet(url)
    if type(body) ~= "string" or #body > 500000 then return nil end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    return ok and data or nil
end

-- same as httpGetJSON but gives up after `secs` so a slow host can't hang the UI
local function httpJSONTimeout(url, secs)
    local done, result = false, nil
    task.spawn(function()
        result = httpGetJSON(url)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (secs or 8) do
        task.wait(0.1)
    end
    return result
end

-- ===================== SAFE SCRIPT EXECUTOR =====================
local function safeExecute(code)
    local ls = loadstring or (getgenv and getgenv().loadstring)
    if not ls then
        return false, "No loadstring available in this executor"
    end
    -- FIX: loadstring returns (function, error). It must NOT be wrapped in pcall,
    -- that was turning the result into "true" and then calling a boolean.
    local fn, compileErr = ls(code)
    if type(fn) ~= "function" then
        return false, "Compile Error: " .. tostring(compileErr)
    end

    -- run in its own thread so long-running scripts don't freeze the panel
    local finished, ok, runErr = false, true, nil
    task.spawn(function()
        ok, runErr = pcall(fn)
        finished = true
    end)

    local t0 = os.clock()
    while not finished and os.clock() - t0 < 0.6 do
        task.wait(0.05)
    end
    if finished and not ok then
        return false, "Runtime Error: " .. tostring(runErr)
    end
    return true, "Executed successfully"
end

-- small "pop" entrance animation used by rows, cards, buttons and chat bubbles
local function popIn(obj, delay)
    local sc = Instance.new("UIScale", obj)
    sc.Scale = 0.9
    task.delay(delay or 0, function()
        if sc.Parent then
            TweenService:Create(sc,
                TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Scale = 1 }):Play()
        end
    end)
end

local function bindTap(row, callback)
    if not (row and callback) then return end
    row.Active = true
    row.Selectable = false
    row.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local startPos = input.Position
        local ended = false
        local conn
        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                ended = true
                if conn then conn:Disconnect() end
                local delta = input.Position - startPos
                if delta.Magnitude <= 12 then callback() end
            end
        end)
        task.delay(2, function() if not ended and conn then conn:Disconnect() end end)
    end)
end

-- Fixed early definition so Players / Info Players / Builder scrolls work
local function bindScrollCanvas(scroll, layout, extraBottom)
    if not (scroll and layout) then return end
    scroll.Active = true
    scroll.ScrollingEnabled = true
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.None
    local pad = extraBottom or 8
    local function update()
        local h = layout.AbsoluteContentSize.Y + pad
        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(h, scroll.AbsoluteWindowSize.Y + 1))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
    scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
    task.defer(update)
    return update
end

