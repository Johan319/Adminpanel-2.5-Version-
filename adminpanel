-- ================= PROPERTIES LOGIC =================
local function setProperty(name, value)
	if not (selected and selected.Parent) then return end
	pcall(function() selected[name] = value end)
	if (name == "Position" or name == "Rotation") and applyBuilderAnimation then
		pcall(applyBuilderAnimation, selected)
	end
	if name == "Name" then refreshExplorer() end
end

local function fmt(n) return tostring(round(n, 3)) end

local function smallBox(parent, text, x, w)
	local f, tb = textBox(parent, "")
	f.Position = UDim2.new(x, 0, 0, 0)
	f.Size = UDim2.new(w, -3, 1, 0)
	tb.Text = text
	return tb
end

local function buildPropertyRow(def, order)
	local ok, value = pcall(function() return selected[def.name] end)
	if def.kind == "source" then ok, value = true, selected.Value end
	if not ok or value == nil then return end
	local tall = (def.kind == "udim2")
	local row = Instance.new("Frame")
	row.LayoutOrder = order
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, tall and 48 or 26)
	row.ZIndex = 22
	row.Parent = propsList
	local l = label(row, def.name, 11, SUB, Enum.Font.Gotham)
	l.Size = UDim2.new(0.4, 0, 0, 26)
	local field = Instance.new("Frame")
	field.BackgroundTransparency = 1
	field.Position = UDim2.new(0.4, 0, 0, 0)
	field.Size = UDim2.new(0.6, 0, 0, tall and 48 or 26)
	field.ZIndex = 22
	field.Parent = row
	local k = def.kind

	if k == "source" then
		local b = button(field, "Edit / Test", ACCENT, Color3.fromRGB(0, 20, 30))
		b.Size = UDim2.new(1, -2, 1, 0)
		b.TextSize = 11
		b.MouseButton1Click:Connect(function() openSource(selected) end)
	elseif k == "string" then
		local f, tb = textBox(field, "")
		f.Size = UDim2.new(1, -2, 1, 0)
		tb.Text = tostring(value)
		tb.FocusLost:Connect(function()
			local t = tb.Text
			if def.name == "Image" and t ~= "" and not t:find("rbxasset") and not t:find("http") then
				local digits = t:match("(%d+)")
				if digits then t = "rbxassetid://" .. digits end
				tb.Text = t
			end
			setProperty(def.name, t)
		end)
	elseif k == "number" then
		local tb = smallBox(field, fmt(value), 0, 1)
		tb.FocusLost:Connect(function()
			local n = num(tb.Text)
			if n then setProperty(def.name, n) else tb.Text = fmt(selected[def.name]) end
		end)
	elseif k == "bool" then
		local b = button(field, value and "true" or "false", PANEL2, value and GREEN or RED)
		b.Size = UDim2.new(1, -2, 1, 0)
		b.TextSize = 11
		b.MouseButton1Click:Connect(function()
			local nv = not selected[def.name]
			setProperty(def.name, nv)
			b.Text = nv and "true" or "false"
			b.TextColor3 = nv and GREEN or RED
		end)
	elseif k == "color" then
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -2, 1, 0)
		b.BackgroundColor3 = value
		b.Text = ""
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.ZIndex = 23
		b.Parent = field
		corner(b, 6)
		stroke(b, DIV, 1, 0)
		b.MouseButton1Click:Connect(function()
			openPicker(selected[def.name], function(c)
				setProperty(def.name, c)
				b.BackgroundColor3 = c
			end)
		end)
	elseif k == "udim2" then
		local boxes = {}
		local vals = { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset }
		local names = { "xS", "xO", "yS", "yO" }
		for i = 1, 4 do
			local f, tb = textBox(field, names[i])
			f.Position = UDim2.new(((i - 1) % 2) * 0.5, 0, 0, math.floor((i - 1) / 2) * 24)
			f.Size = UDim2.new(0.5, -3, 0, 22)
			tb.Text = fmt(vals[i])
			boxes[i] = tb
		end
		local function commit()
			local cur = selected[def.name]
			setProperty(def.name, UDim2.new(num(boxes[1].Text) or cur.X.Scale, num(boxes[2].Text) or cur.X.Offset,
				num(boxes[3].Text) or cur.Y.Scale, num(boxes[4].Text) or cur.Y.Offset))
		end
		for _, tb in ipairs(boxes) do tb.FocusLost:Connect(commit) end
	elseif k == "udim" then
		local a = smallBox(field, fmt(value.Scale), 0, 0.5)
		local b = smallBox(field, fmt(value.Offset), 0.5, 0.5)
		local function commit()
			local cur = selected[def.name]
			setProperty(def.name, UDim.new(num(a.Text) or cur.Scale, num(b.Text) or cur.Offset))
		end
		a.FocusLost:Connect(commit)
		b.FocusLost:Connect(commit)
	elseif k == "vector2" then
		local a = smallBox(field, fmt(value.X), 0, 0.5)
		local b = smallBox(field, fmt(value.Y), 0.5, 0.5)
		local function commit()
			local cur = selected[def.name]
			setProperty(def.name, Vector2.new(num(a.Text) or cur.X, num(b.Text) or cur.Y))
		end
		a.FocusLost:Connect(commit)
		b.FocusLost:Connect(commit)
	elseif k == "enum" then
		local items = def.enum:GetEnumItems()
		local prev = button(field, "<", PANEL2, TEXT)
		prev.Size = UDim2.new(0, 22, 1, 0)
		local nextB = button(field, ">", PANEL2, TEXT)
		nextB.AnchorPoint = Vector2.new(1, 0)
		nextB.Position = UDim2.new(1, -2, 0, 0)
		nextB.Size = UDim2.new(0, 22, 1, 0)
		local shown = label(field, value.Name, 11, TEXT, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
		shown.Position = UDim2.new(0, 24, 0, 0)
		shown.Size = UDim2.new(1, -50, 1, 0)
		local function step(delta)
			local cur = selected[def.name]
			local idx = 1
			for i, it in ipairs(items) do
				if it == cur then idx = i break end
			end
			local nxt = items[((idx - 1 + delta) % #items) + 1]
			setProperty(def.name, nxt)
			shown.Text = nxt.Name
		end
		prev.MouseButton1Click:Connect(function() step(-1) end)
		nextB.MouseButton1Click:Connect(function() step(1) end)
	elseif k == "gradient" then
		local function ends()
			local kp = selected[def.name].Keypoints
			return kp[1].Value, kp[#kp].Value
		end
		local c1, c2 = ends()
		local function swatch(x, col, which)
			local b = Instance.new("TextButton")
			b.Position = UDim2.new(x, 0, 0, 0)
			b.Size = UDim2.new(0.5, -3, 1, 0)
			b.BackgroundColor3 = col
			b.Text = ""
			b.AutoButtonColor = false
			b.BorderSizePixel = 0
			b.ZIndex = 23
			b.Parent = field
			corner(b, 6)
			stroke(b, DIV, 1, 0)
			b.MouseButton1Click:Connect(function()
				local a, z = ends()
				openPicker(which == 1 and a or z, function(c)
					local a2, z2 = ends()
					if which == 1 then a2 = c else z2 = c end
					setProperty(def.name, ColorSequence.new(a2, z2))
					b.BackgroundColor3 = c
				end)
			end)
		end
		swatch(0, c1, 1)
		swatch(0.5, c2, 2)
	end
end

function refreshProperties()
	for _, c in ipairs(propsList:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	if not (selected and selected.Parent) then
		propsTitle.Text = "Properties"
		return
	end
	local cls = CLASSES[keyOf(selected)]
	if not cls then return end
	propsTitle.Text = "Properties - " .. keyOf(selected)
	if selected:IsA("GuiObject") and selected:GetAttribute("BAnimation") then
		propsTitle.Text = propsTitle.Text .. "  •  " .. tostring(selected:GetAttribute("BAnimation"))
	end
	local q = propsSearch.Text:lower()
	local order = 0
	for _, def in ipairs(cls.props) do
		if q == "" or def.name:lower():find(q, 1, true) then
			order += 1
			buildPropertyRow(def, order)
		end
	end
end
propsSearch:GetPropertyChangedSignal("Text"):Connect(function() refreshProperties() end)

-- ================= SAVE / LOAD (files on your device) =================
local saveWin, saveBody = makeWindow("SaveLoad", "Save / Load", 300, 340, UDim2.new(0.5, -150, 0.5, -170))
local saveStatus
local autosaveNow, autoloadOnce
do
	local DIR = "AdminPanel_Builder"
	local hasFS = (writefile ~= nil and readfile ~= nil and isfile ~= nil
		and makefolder ~= nil and isfolder ~= nil and listfiles ~= nil)
	local session = {}   -- used when your executor cannot write files

	local function fileFor(name) return DIR .. "/" .. name .. ".json" end

	local function storeWrite(name, json)
		session[name] = json
		if hasFS then
			pcall(function()
				if not isfolder(DIR) then makefolder(DIR) end
				writefile(fileFor(name), json)
			end)
		end
	end

	local function storeRead(name)
		if hasFS then
			local ok, r = pcall(function()
				if isfile(fileFor(name)) then return readfile(fileFor(name)) end
			end)
			if ok and type(r) == "string" then return r end
		end
		return session[name]
	end

	local function storeDelete(name)
		session[name] = nil
		if hasFS then
			pcall(function()
				if delfile and isfile(fileFor(name)) then delfile(fileFor(name)) end
			end)
		end
	end

	local function storeList()
		local names, seen = {}, {}
		local function add(n)
			if n and not seen[n] and n:sub(1, 1) ~= "_" then
				seen[n] = true
				names[#names + 1] = n
			end
		end
		for n in pairs(session) do add(n) end
		if hasFS then
			pcall(function()
				if isfolder(DIR) then
					for _, path in ipairs(listfiles(DIR)) do
						local f = tostring(path):match("([^/\\]+)$") or ""
						add(f:match("^(.+)%.json$"))
					end
				end
			end)
		end
		table.sort(names)
		return names
	end

	local function snapshotJson()
		return HttpService:JSONEncode(serializeChildren(projectGui))
	end

	local function loadJson(json)
		local ok, nodes = pcall(function() return HttpService:JSONDecode(json) end)
		if not ok or type(nodes) ~= "table" then return false end
		selectInstance(nil)
		for _, ch in ipairs(projectGui:GetChildren()) do
			if CLASSES[keyOf(ch)] then ch:Destroy() end
		end
		buildCount = 0
		for _, n in ipairs(nodes) do buildNode(n, projectGui, 1) end
		refreshExplorer()
		return true
	end

	function autosaveNow()
		if #projectGui:GetChildren() > 0 then
			storeWrite("_autosave", snapshotJson())
			storeWrite("_server_" .. tostring(currentBuilderServer):gsub("[^%w_%- ]", ""), snapshotJson())
		end
	end

	local restored = false
	function autoloadOnce()
		if restored then return end
		restored = true
		local safeName = tostring(currentBuilderServer):gsub("[^%w_%- ]", "")
		local json = storeRead("_server_" .. safeName) or storeRead("_autosave")
		if json then loadJson(json) end
	end

	local nameBox, nameInput = textBox(saveBody, "Save name")
	nameBox.Position = UDim2.new(0, 8, 0, 8)
	nameBox.Size = UDim2.new(1, -108, 0, 30)
	local saveNew = button(saveBody, "Save", GREEN, Color3.fromRGB(8, 28, 16))
	saveNew.AnchorPoint = Vector2.new(1, 0)
	saveNew.Position = UDim2.new(1, -8, 0, 8)
	saveNew.Size = UDim2.fromOffset(92, 30)
	local list = scroller(saveBody)
	list.Position = UDim2.new(0, 8, 0, 46)
	list.Size = UDim2.new(1, -16, 1, -74)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	saveStatus = label(saveBody, "", 11, SUB, Enum.Font.Gotham)
	saveStatus.AnchorPoint = Vector2.new(0, 1)
	saveStatus.Position = UDim2.new(0, 10, 1, -6)
	saveStatus.Size = UDim2.new(1, -20, 0, 16)

	local renderSaves
	function renderSaves()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local names = storeList()
		for i, n in ipairs(names) do
			local row = Instance.new("Frame")
			row.LayoutOrder = i
			row.Size = UDim2.new(1, -6, 0, 34)
			row.BackgroundColor3 = PANEL
			row.BorderSizePixel = 0
			row.ZIndex = 22
			row.Parent = list
			corner(row, 6)
			local t = label(row, n, 12, TEXT, Enum.Font.Gotham)
			t.Position = UDim2.new(0, 8, 0, 0)
			t.Size = UDim2.new(1, -150, 1, 0)
			local function mini(text, x, color)
				local b = button(row, text, PANEL2, color)
				b.AnchorPoint = Vector2.new(1, 0.5)
				b.Position = UDim2.new(1, x, 0.5, 0)
				b.Size = UDim2.fromOffset(42, 24)
				b.TextSize = 10
				return b
			end
			mini("Load", -92, GREEN).MouseButton1Click:Connect(function()
				local json = storeRead(n)
				saveStatus.Text = (json and loadJson(json)) and ("Loaded: " .. n) or "Could not load that save"
			end)
			mini("Update", -48, ACCENT).MouseButton1Click:Connect(function()
				storeWrite(n, snapshotJson())
				saveStatus.Text = "Updated: " .. n
			end)
			mini("X", -4, RED).MouseButton1Click:Connect(function()
				storeDelete(n)
				saveStatus.Text = "Deleted: " .. n
				renderSaves()
			end)
		end
		if #names == 0 then saveStatus.Text = "No saves yet" end
	end

	saveNew.MouseButton1Click:Connect(function()
		local name = (nameInput.Text:gsub("[^%w_%- ]", "")):gsub("^%s+", ""):gsub("%s+$", "")
		name = name:sub(1, 24)
		if name == "" or name:sub(1, 1) == "_" then
			saveStatus.Text = "Type a name first (it cannot start with _)"
			return
		end
		storeWrite(name, snapshotJson())
		nameInput.Text = ""
		saveStatus.Text = "Saved: " .. name
		renderSaves()
	end)
	saveWin:GetPropertyChangedSignal("Visible"):Connect(function()
