-- POST JSON to Termux / MOD API so bans & ranks auto-sync
local function httpRequest(method, url, body)
    local headers = {
        ["Content-Type"] = "application/json",
        ["Accept"] = "application/json",
    }
    local opts = { Url = url, Method = method, Headers = headers, Body = body or "" }
    -- some executors use lowercase keys
    local opts2 = { url = url, method = method, headers = headers, body = body or "" }
    local result = nil
    local tried = {}
    local function try(fn, name)
        if result then return end
        local ok, res = pcall(fn)
        tried[#tried + 1] = name
        if ok and type(res) == "table" then
            result = res
        end
    end
    try(function()
        if syn and syn.request then return syn.request(opts) end
    end, "syn.request")
    try(function()
        if http_request then return http_request(opts) end
    end, "http_request")
    try(function()
        if request then return request(opts) end
    end, "request")
    try(function()
        if fluxus and fluxus.request then return fluxus.request(opts) end
    end, "fluxus")
    try(function()
        if http and http.request then return http.request(opts) end
    end, "http.request")
    try(function()
        if syn and syn.request then return syn.request(opts2) end
    end, "syn.request2")
    try(function()
        if request then return request(opts2) end
    end, "request2")
    return result, tried
end

local function httpOk(res)
    if type(res) ~= "table" then return false end
    if res.Success == true then return true end
    local code = res.StatusCode or res.Status or res.status_code or res.statusCode
    code = tonumber(code)
    return code == 200 or code == 201 or code == 204
end

Shared.pushModApi = function(path, payload)
    local base = tostring(Shared.MOD_API_URL or "")
    if base == "" then return false, "MOD_API_URL not set" end
    local url = base:gsub("/$", "") .. path
    local body = HttpService:JSONEncode(payload or {})
    local res, tried = httpRequest("POST", url, body)
    if httpOk(res) then
        return true, res
    end
    -- last resort: some environments only allow GET — encode action in query (server may ignore)
    return false, "POST failed (" .. table.concat(tried or {}, ",") .. ")"
end

