Shared.view = { target = nil, conns = {}, listeners = {} }

function Shared.viewStop()
    local v = Shared.view
    for _, c in ipairs(v.conns) do pcall(function() c:Disconnect() end) end
    v.conns = {}
    local was = v.target
    v.target = nil
    local cam = workspace.CurrentCamera
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if cam and hum then
        cam.CameraSubject = hum
        cam.CameraType = Enum.CameraType.Custom
    end
end

function Shared.viewStart(plr)
    if not plr or plr == LP then
        Shared.viewStop()
        return
    end
    local v = Shared.view
    for _, c in ipairs(v.conns) do pcall(function() c:Disconnect() end) end
    v.conns = {}
    v.target = plr

    local function follow()
        local char = plr.Character
        local hum = char and (char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5))
        local cam = workspace.CurrentCamera
        if hum and cam and v.target == plr then
            cam.CameraSubject = hum
            cam.CameraType = Enum.CameraType.Custom
        end
    end
    task.spawn(follow)
    table.insert(v.conns, plr.CharacterAdded:Connect(function() task.spawn(follow) end))
    table.insert(v.conns, Players.PlayerRemoving:Connect(function(leaving)
        if leaving == plr then Shared.viewStop() end
    end))
    table.insert(v.conns, UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.KeyCode == Enum.KeyCode.Space or inp.KeyCode == Enum.KeyCode.Escape then
            Shared.viewStop()
        end
    end))
end

Shared.vanish = { hidden = {}, conns = {} }

function Shared.vanishOn(plr)
    if not plr or plr == LP or Shared.vanish.hidden[plr.UserId] then return false end
    Shared.vanish.hidden[plr.UserId] = true
    local function hide(char)
        if char and char.Parent then char.Parent = nil end
    end
    hide(plr.Character)
    Shared.vanish.conns[plr.UserId] = plr.CharacterAdded:Connect(function(char)
        if Shared.vanish.hidden[plr.UserId] then hide(char) end
    end)
    return true
end

function Shared.vanishOff(plr)
    if not plr then return false end
    local uid = plr.UserId
    if not Shared.vanish.hidden[uid] then return false end
    Shared.vanish.hidden[uid] = nil
    local conn = Shared.vanish.conns[uid]
    if conn then
        conn:Disconnect()
        Shared.vanish.conns[uid] = nil
    end
    if plr.Character and plr.Character.Parent == nil then
        plr.Character.Parent = workspace
    end
    return true
end

function Shared._getMyProps()
    local props = {}
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if not workspaceCom then return props end
    local myName = LP.Name
    for _, folder in ipairs(workspaceCom:GetChildren()) do
        for _, prop in ipairs(folder:GetChildren()) do
            if prop:FindFirstChild("SetCurrentCFrame") then
                local n = prop.Name
                if n:find("Prop" .. myName, 1, true) or n:find(myName, 1, true) then
                    table.insert(props, prop)
                end
            end
        end
    end
    return props
end

function Shared.clearMyProps()
    Shared._propKeepAlive = false
    Shared._propSlice = nil
    pcall(function()
        local RE = ReplicatedStorage:FindFirstChild("RE")
        local clear = RE and RE:FindFirstChild("1Clea1rTool1s")
        if clear then
            clear:FireServer("ClearAllProps")
            clear:FireServer("ClearAllTools")
        end
    end)
end

function Shared._teleportMyProps(cf)
    local list = Shared._propSlice
    if type(list) ~= "table" or #list == 0 then
        list = Shared._getMyProps()
    end
    for _, prop in ipairs(list) do
        if prop and prop.Parent and prop:FindFirstChild("SetCurrentCFrame") then
            task.spawn(function()
                pcall(function() prop.SetCurrentCFrame:InvokeServer(cf) end)
            end)
        end
    end
end

function Shared._propMovePlayer(targetPlayer, mode)
    if not targetPlayer or targetPlayer == LP then return false, "Invalid target" end
    mode = mode or "bring"
    task.spawn(function()
        local RE = ReplicatedStorage:FindFirstChild("RE")
        if not RE then return end
        local clearTools = RE:FindFirstChild("1Clea1rTool1s")
        local toolPick = RE:FindFirstChild("1Too1l")
        if not clearTools or not toolPick then return end

        local keep = Shared._propKeepAlive == true
        local function ClearTools()
            if keep then return end
            pcall(function()
                clearTools:FireServer("ClearAllTools")
                clearTools:FireServer("ClearAllProps")
            end)
        end

        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then return end

        local existing = Shared._getMyProps()
        if not keep or #existing == 0 then
            if not keep then
                ClearTools()
                task.wait(0.15)
            end
            pcall(function() toolPick:InvokeServer("PickingTools", "PropMaker") end)
            task.wait(0.35)
            local tool = LP.Backpack:FindFirstChild("PropMaker")
                or (LP.Character and LP.Character:FindFirstChild("PropMaker"))
                or LP.Backpack:WaitForChild("PropMaker", 5)
            if tool then
                pcall(function() humanoid:EquipTool(tool) end)
                task.wait(0.25)
                pcall(function()
                    clearTools:FireServer("RequestingPropName", "FurnitureBleachers", "Furniture")
                end)
                task.wait(0.4)
                local toolRemote = tool:FindFirstChild("Tool_PropMake")
                local base
                pcall(function()
                    base = workspace:WaitForChild("__DEV", 2)
                        :WaitForChild("SwappableWorld", 2)
                        :WaitForChild("SideArea", 2)
                        :WaitForChild("ToBeSwapped", 2)
                        :WaitForChild("Baseplate", 2)
                end)
                if not base then
                    pcall(function()
                        local street = workspace:FindFirstChild("Model")
                        street = street and street:FindFirstChild("Street")
                        base = street and street:FindFirstChild("Street") or workspace
                    end)
                end
                if toolRemote and base then
                    local pos = hrp.Position + Vector3.new(0, -8, 0)
                    for _ = 1, 2 do
                        pcall(function() toolRemote:FireServer(base, pos) end)
                        task.wait(0.25)
                    end
                end
                for _ = 1, 12 do
                    if #Shared._getMyProps() > 0 then break end
                    task.wait(0.12)
                end
            end
        end

        local destinationCF
        if mode == "kill" then
            destinationCF = CFrame.new(216, -1338, -477)
        elseif mode == "fling" then
            destinationCF = CFrame.new(1082537, 81322368, -4719626)
        else
            destinationCF = hrp.CFrame * CFrame.new(0, 0, -5)
        end

        local wasSitting = false
        local liftOffset = -10
        local connection
        local startTime = tick()

        connection = RunService.Heartbeat:Connect(function()
            local c = targetPlayer.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")

            if not r or not h or (tick() - startTime > 14) then
                if connection then connection:Disconnect() connection = nil end
                if not keep then ClearTools() end
                return
            end

            if h.Sit then
                if not wasSitting then
                    wasSitting = true
                    Shared._teleportMyProps(destinationCF)
                    task.wait(0.5)
                    if connection then connection:Disconnect() connection = nil end
                    if not keep then ClearTools() end
                else
                    Shared._teleportMyProps(destinationCF)
                end
            else
                wasSitting = false
                liftOffset = liftOffset + 0.5
                if liftOffset > 2 then liftOffset = -10 end
                Shared._teleportMyProps(r.CFrame * CFrame.new(0, liftOffset, 0))
            end
        end)
    end)
    local label = "Bringing"
    if mode == "kill" then label = "Killing"
    elseif mode == "fling" then label = "Flinging" end
    return true, label .. " " .. (targetPlayer.Name or "?")
end

function Shared.bringPlayer(targetPlayer)
    local ok, msg = Shared._propMovePlayer(targetPlayer, "bring")
    if not Shared._propKeepAlive then
        task.delay(3.5, function()
            if not Shared._propKeepAlive then Shared.clearMyProps() end
        end)
    end
    return ok, msg
end

function Shared.killPlayer(targetPlayer)
    local ok, msg = Shared._propMovePlayer(targetPlayer, "kill")
    if not Shared._propKeepAlive then
        task.delay(3.5, function()
            if not Shared._propKeepAlive then Shared.clearMyProps() end
        end)
    end
    return ok, msg
end

function Shared.flingPlayer(targetPlayer)
