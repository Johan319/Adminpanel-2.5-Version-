    end)

    local function refreshPropCount()
        local n = countMyProps()
        countLbl.Text = tostring(n)
        Shared.propCount = n
    end

    local abuseState = { bringAll = false, killAll = false }
    local abuseThreads = {}

    local function makeAbuseToggle(order, name, key, mode)
        local row = Instance.new("Frame", AdminAbusePage)
        row.LayoutOrder = order
        row.BackgroundColor3 = Panel
        row.BorderSizePixel = 0
        row.Size = UDim2.new(1, 0, 0, 48)
        row.ZIndex = 4
        corner(row, 12)
