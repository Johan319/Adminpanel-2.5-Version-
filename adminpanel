-- ===== Fly (Mods) — camera-relative direction =====
Shared.flyState = {
    on = false,
    speed = 50,
    minSpeed = 1,
    maxSpeed = 500,
    bv = nil,
    bg = nil,
    conn = nil,
    keys = { W=false, A=false, S=false, D=false, Up=false, Down=false },
    inputConns = {},
}

function Shared.stopFly()
    local st = Shared.flyState
    st.on = false
    for k in pairs(st.keys) do st.keys[k] = false end
    if st.conn then pcall(function() st.conn:Disconnect() end) st.conn = nil end
    for _, c in ipairs(st.inputConns) do pcall(function() c:Disconnect() end) end
    st.inputConns = {}
    if st.bv then pcall(function() st.bv:Destroy() end) st.bv = nil end
    if st.bg then pcall(function() st.bg:Destroy() end) st.bg = nil end
    pcall(function()
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end)
    return true, "Fly OFF"
end

function Shared.startFly(speed)
    local st = Shared.flyState
    speed = tonumber(speed) or st.speed or 50
    speed = math.clamp(speed, st.minSpeed, st.maxSpeed)
    st.speed = speed
    Shared.stopFly()
    st.on = true

    local char = LP.Character
    if not char then return false, "No character" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "No root" end

    hum.PlatformStand = true

    local bg = Instance.new("BodyGyro")
    bg.Name = "AdminPanelFlyGyro"
    bg.P = 9e4
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    local bv = Instance.new("BodyVelocity")
    bv.Name = "AdminPanelFlyVel"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    st.bg = bg
    st.bv = bv

    local UIS = UserInputService
    local function setKey(code, on)
        if code == Enum.KeyCode.W then st.keys.W = on
        elseif code == Enum.KeyCode.A then st.keys.A = on
        elseif code == Enum.KeyCode.S then st.keys.S = on
        elseif code == Enum.KeyCode.D then st.keys.D = on
        elseif code == Enum.KeyCode.E or code == Enum.KeyCode.Space then st.keys.Up = on
        elseif code == Enum.KeyCode.Q or code == Enum.KeyCode.LeftControl or code == Enum.KeyCode.LeftShift then st.keys.Down = on
        end
    end
    table.insert(st.inputConns, UIS.InputBegan:Connect(function(inp, g)
        if g then return end
        setKey(inp.KeyCode, true)
    end))
    table.insert(st.inputConns, UIS.InputEnded:Connect(function(inp)
        setKey(inp.KeyCode, false)
    end))

    st.conn = RunService.RenderStepped:Connect(function()
        if not st.on then return end
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if not root or not st.bv or not st.bg then return end

        local cam = workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        -- flatten horizontal move to camera yaw (direction follows where you look)
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end

        local dir = Vector3.zero
        -- Keyboard
        if st.keys.W then dir = dir + flatLook end
        if st.keys.S then dir = dir - flatLook end
        if st.keys.A then dir = dir - flatRight end
        if st.keys.D then dir = dir + flatRight end
        if st.keys.Up then dir = dir + Vector3.new(0, 1, 0) end
        if st.keys.Down then dir = dir + Vector3.new(0, -1, 0) end

        -- Mobile / stick: Humanoid.MoveDirection is world-space, project to horizontal + camera
        if humanoid and dir.Magnitude < 0.05 then
            local md = humanoid.MoveDirection
            if md.Magnitude > 0.05 then
                dir = dir + Vector3.new(md.X, 0, md.Z)
            end
        end

        if dir.Magnitude > 0 then
            dir = dir.Unit * st.speed
        end
        st.bv.Velocity = dir
        -- face camera look direction
        local face = Vector3.new(look.X, 0, look.Z)
        if face.Magnitude > 0.05 then
            st.bg.CFrame = CFrame.new(root.Position, root.Position + face)
        else
            st.bg.CFrame = CFrame.new(root.Position) * (cam.CFrame - cam.CFrame.Position)
        end
        if humanoid then humanoid.PlatformStand = true end
    end)

    return true, "Fly ON · speed " .. tostring(speed)
end

function Shared.setFlySpeed(speed)
    speed = tonumber(speed)
    if not speed then return false, "Need speed number" end
    local st = Shared.flyState
    st.speed = math.clamp(speed, st.minSpeed, st.maxSpeed)
    if st.on then
        return Shared.startFly(st.speed)
    end
    return true, "Fly speed " .. st.speed
end





function Shared._getMyProps()
    local props = {}
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if not workspaceCom then return props end
    local myName = LP.Name
    for _, folder in ipairs(workspaceCom:GetChildren()) do
        for _, prop in ipairs(folder:GetChildren()) do
            if prop:FindFirstChild("SetCurrentCFrame") then
                local n = prop.Name
                if n:find("Prop" .. myName, 1, true) or n:find(myName, 1, true) then
                    table.insert(props, prop)
                end
            end
        end
    end
    return props
end

function Shared.clearMyProps()
    Shared._propKeepAlive = false
    Shared._propSlice = nil
    pcall(function()
        local RE = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
        local clear = RE and RE:FindFirstChild("1Clea1rTool1s")
        if clear then
            clear:FireServer("ClearAllProps")
            clear:FireServer("ClearAllTools")
        end
    end)
end

function Shared._teleportMyProps(cf)
    local list = Shared._propSlice
    if type(list) ~= "table" or #list == 0 then
        list = Shared._getMyProps()
    end
    for _, prop in ipairs(list) do
        if prop and prop.Parent and prop:FindFirstChild("SetCurrentCFrame") then
            task.spawn(function()
                pcall(function() prop.SetCurrentCFrame:InvokeServer(cf) end)
            end)
        end
    end
end

function Shared._propMovePlayer(targetPlayer, mode)
    -- mode: "bring" | "kill" | "fling"
    -- Shared._propKeepAlive = true  → never ClearAllProps/Tools; reuse existing props (Admin Abuse)
    if not targetPlayer or targetPlayer == LP then return false, "Invalid target" end
    mode = mode or "bring"
    task.spawn(function()
        local RS = game:GetService("ReplicatedStorage")
        local VirtualUser = game:GetService("VirtualUser")
        local RE = RS:FindFirstChild("RE")
        if not RE then return end
        local clearTools = RE:FindFirstChild("1Clea1rTool1s")
        local toolPick = RE:FindFirstChild("1Too1l")
        if not clearTools or not toolPick then return end

        local keep = Shared._propKeepAlive == true

        local function ClearTools()
            if keep then return end -- NEVER clear while Admin Abuse is running
            pcall(function()
                clearTools:FireServer("ClearAllTools")
                clearTools:FireServer("ClearAllProps")
            end)
        end

        local function GetMyProps()
            return Shared._getMyProps()
        end

        local function TeleportProps(cf)
            Shared._teleportMyProps(cf)
        end

        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then return end

        local existing = GetMyProps()
        if not keep or #existing == 0 then
            if not keep then
                ClearTools()
                task.wait(0.15)
            end
            pcall(function() toolPick:InvokeServer("PickingTools", "PropMaker") end)
            task.wait(0.35)
            local tool = LP.Backpack:FindFirstChild("PropMaker")
                or (LP.Character and LP.Character:FindFirstChild("PropMaker"))
                or LP.Backpack:WaitForChild("PropMaker", 5)
            if tool then
                pcall(function() humanoid:EquipTool(tool) end)
                task.wait(0.25)
                pcall(function()
                    clearTools:FireServer("RequestingPropName", "FurnitureBleachers", "Furniture")
                end)
                task.wait(0.4)
                local toolRemote = tool:FindFirstChild("Tool_PropMake")
                    or (LP.Character and LP.Character:FindFirstChild("PropMaker") and LP.Character.PropMaker:FindFirstChild("Tool_PropMake"))
                local base
                pcall(function()
                    base = workspace:WaitForChild("__DEV", 2)
                        :WaitForChild("SwappableWorld", 2)
                        :WaitForChild("SideArea", 2)
                        :WaitForChild("ToBeSwapped", 2)
                        :WaitForChild("Baseplate", 2)
                end)
                if not base then
                    pcall(function()
                        local street = workspace:FindFirstChild("Model")
                        street = street and street:FindFirstChild("Street")
                        base = street and street:FindFirstChild("Street") or workspace
                    end)
                end
                if toolRemote and base then
                    local pos = hrp.Position + Vector3.new(0, -8, 0)
                    for _ = 1, 2 do
                        pcall(function() toolRemote:FireServer(base, pos) end)
                        task.wait(0.25)
                    end
                end
                pcall(function()
                    VirtualUser:Button1Down(Vector2.new(0, 500), workspace.CurrentCamera.CFrame)
                    task.wait(0.08)
                    VirtualUser:Button1Up(Vector2.new(0, 500), workspace.CurrentCamera.CFrame)
                end)
                -- wait until at least 1 prop exists (max ~2s)
                for _ = 1, 12 do
                    if #GetMyProps() > 0 then break end
                    task.wait(0.12)
                end
            end
        end
        -- if keep && existing props: do NOT equip / place again — just move them with the player

        local destinationCF
        if mode == "kill" then
            destinationCF = CFrame.new(216, -1338, -477)
        elseif mode == "fling" then
            destinationCF = CFrame.new(1082537, 81322368, -4719626)
        else
            destinationCF = hrp.CFrame * CFrame.new(0, 0, -5)
        end

        local wasSitting = false
        local liftOffset = -10
        local connection
        local startTime = tick()

        connection = RunService.Heartbeat:Connect(function()
            local c = targetPlayer.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")

            if not r or not h or (tick() - startTime > 14) then
                if connection then connection:Disconnect() connection = nil end
                -- props stay when keep; player already moved with them
                if not keep then ClearTools() end
                return
            end

            if h.Sit then
                if not wasSitting then
                    wasSitting = true
                    -- seat taken → move props + seated player to destination together
                    TeleportProps(destinationCF)
                    task.wait(0.5)
